on":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/datagen24/victual/milestones/4","html_url":"https://github.com/datagen24/victual/milestone/4","labels_url":"https://api.github.com/repos/datagen24/victual/milestones/4/labels","id":18587266,"node_id":"MI_kwDOUEWha84BG56C","number":4,"title":"0.4.3","description":"","creator":{"login":"datagen24","id":20876965,"node_id":"MDQ6VXNlcjIwODc2OTY1","avatar_url":"https://avatars.githubusercontent.com/u/20876965?v=4","gravatar_id":"","url":"https://api.github.com/users/datagen24","html_url":"https://github.com/datagen24","followers_url":"https://api.github.com/users/datagen24/followers","following_url":"https://api.github.com/users/datagen24/following{/other_user}","gists_url":"https://api.github.com/users/datagen24/gists{/gist_id}","starred_url":"https://api.github.com/users/datagen24/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/datagen24/subscriptions","organizations_url":"https://api.github.com/users/datagen24/orgs","repos_url":"https://api.github.com/users/datagen24/repos","events_url":"https://api.github.com/users/datagen24/events{/privacy}","received_events_url":"https://api.github.com/users/datagen24/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":6,"closed_issues":0,"state":"open","created_at":"2026-10-14T21:17:34Z","updated_at":"2026-10-14T21:18:33Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-10-13T00:57:18Z","updated_at":"2026-10-14T21:18:31Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Test helpers that start a PHP subprocess read its stdout to EOF before reading stderr. A child that writes more than the 64 KB pipe buffer to stderr blocks, never closes stdout, and deadlocks the test run while holding database locks.\n\n## Where\n\n- `tests/Pgsql/InfluxPermanentRejectionTest.php`: `Drain()` (~:176)\n- `tests/Pgsql/OutboxClaimConcurrencyTest.php`: `finishSubprocess()` (~:213)\n- About 75 files under `tests/Pgsql/` use the same stdout-then-stderr pattern\n\n## Evidence\n\nOn 2026-10-12 an `mqttcoverage` run hung for 2.5 hours. A second hang was diagnosed from `/proc`:\n- `outbox-claim-subprocess-helper.php drain` was blocked in `anon_pipe_write`;\n- its database session sat \"idle in transaction\";\n- PHPUnit waited on stdout.\n\nThe child had logged about 78 KB (399 `error_log` lines for a 201-row probe).\n\n## Failure scenario\n\nAny test, or future test, whose child writes more than 64 KB to stderr hangs the suite indefinitely instead of failing. In CI that runs until the job timeout; locally it holds the shared runner lock.\n\n## Possible direction\n\nRead both pipes together (`stream_select`, or `stream_set_blocking(false)` with a loop), or send the child's stderr to a temp file, in one shared helper used by every subprocess test.\n\n## How this was found\n\nReported by an independent validator during the 2026-10-12 audit remediation (issues #846–#868), while it reviewed PR #874 (#854).\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/datagen24/victual/issues/904/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/datagen24/victual/issues/904/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}
