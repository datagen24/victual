2026-10-15T16:24:47.1511765Z  	-- Issue #558 (#487 remediation): deleting a product retires its stock entries' labels with
2026-10-15T16:24:47.1511911Z  	-- product_name null. trg_cascade_product_removal (migrations/0279.pgsql.sql) is an AFTER
2026-10-15T16:24:47.1512053Z  	-- DELETE ON products trigger; by the time its "DELETE FROM stock WHERE product_id = OLD.id"
2026-10-15T16:24:47.1512181Z  	-- runs, the products row is already gone, so retire_stock_entry_labels' (migrations/
2026-10-15T16:24:47.1512319Z  	-- 0283.pgsql.php) own `(SELECT p.name FROM products p WHERE p.id = OLD.product_id)` lookup
2026-10-15T16:24:47.1512382Z  	-- finds nothing and snapshots NULL.
2026-10-15T16:24:47.1512431Z  	--
2026-10-15T16:24:47.1512568Z  	-- Fix: retire those labels here first, with OLD.name - which is still readable inside an
2026-10-15T16:24:47.1512708Z  	-- AFTER DELETE trigger, since OLD is the row image, not a live read of the table - before the
2026-10-15T16:24:47.1512847Z  	-- stock rows are deleted. This is the smaller of the issue's two suggested fixes: it extends
2026-10-15T16:24:47.1513076Z  	-- trg_cascade_product_removal's function body by CREATE OR REPLACE, the same mechanism 0279
2026-10-15T16:24:47.1513216Z  	-- itself used to add the product_substitutions cascade, and it leaves retire_stock_entry_
2026-10-15T16:24:47.1513338Z  	-- labels and its BEFORE DELETE ON stock trigger completely untouched, so a direct
2026-10-15T16:24:47.1513465Z  	-- `DELETE FROM stock` (with its product row still present) keeps behaving exactly as
2026-10-15T16:24:47.1513625Z  	-- .devtools/pgtap/016-label-retirement-family.sql already proves. The alternative the issue
2026-10-15T16:24:47.1513768Z  	-- names - moving retire_stock_entry_labels itself to run earlier, or off of `stock` entirely
2026-10-15T16:24:47.1513909Z  	-- - would touch a second migration's trigger for every stock deletion path, not only this
2026-10-15T16:24:47.1513957Z  	-- cascade.
2026-10-15T16:24:47.1514004Z  	--
2026-10-15T16:24:47.1514141Z  	-- The new UPDATE only retires a label that is still live (retired_at IS NULL), so when the
2026-10-15T16:24:47.1514287Z  	-- subsequent `DELETE FROM stock` fires retire_stock_entry_labels per row, that trigger's own
2026-10-15T16:24:47.1514430Z  	-- `retired_at IS NULL` guard already excludes the rows this UPDATE just retired - no double
2026-10-15T16:24:47.1514495Z  	-- retirement, no snapshot overwrite.
2026-10-15T16:24:47.1514618Z  	CREATE OR REPLACE FUNCTION trg_cascade_product_removal() RETURNS TRIGGER AS $$
2026-10-15T16:24:47.1514665Z  	BEGIN
2026-10-15T16:24:47.1514717Z  		UPDATE labels
2026-10-15T16:24:47.1514801Z  		SET retired_at = CURRENT_TIMESTAMP, target_id = NULL,
2026-10-15T16:24:47.1514872Z  			retirement_snapshot = jsonb_build_object(
2026-10-15T16:24:47.1514919Z  				'id', s.id,
2026-10-15T16:24:47.1514977Z  				'product_name', OLD.name,
2026-10-15T16:24:47.1515042Z  				'best_before_date', s.best_before_date,
2026-10-15T16:24:47.1515096Z  				'amount', s.amount)
2026-10-15T16:24:47.1515143Z  		FROM stock s
2026-10-15T16:24:47.1515204Z  		WHERE labels.kind = 'stock_entry'
2026-10-15T16:24:47.1515267Z  			AND labels.target_id = s.id
2026-10-15T16:24:47.1515327Z  			AND labels.retired_at IS NULL
2026-10-15T16:24:47.1515456Z  			AND s.product_id = OLD.id;
2026-10-15T16:24:47.1515504Z  	
2026-10-15T16:24:47.1515556Z  		DELETE FROM stock
2026-10-15T16:24:47.1515612Z  		WHERE product_id = OLD.id;
2026-10-15T16:24:47.1515658Z  	
2026-10-15T16:24:47.1515711Z  		DELETE FROM stock_log
2026-10-15T16:24:47.1515766Z  		WHERE product_id = OLD.id;
2026-10-15T16:24:47.1515810Z  	
2026-10-15T16:24:47.1515867Z  		DELETE FROM product_barcodes
2026-10-15T16:24:47.1515922Z  		WHERE product_id = OLD.id;
2026-10-15T16:24:47.1515967Z  	
2026-10-15T16:24:47.1516031Z  		DELETE FROM quantity_unit_conversions
2026-10-15T16:24:47.1516085Z  		WHERE product_id = OLD.id;
2026-10-15T16:24:47.1516132Z  	
2026-10-15T16:24:47.1516187Z  		DELETE FROM recipes_pos
2026-10-15T16:24:47.1516240Z  		WHERE product_id = OLD.id;
2026-10-15T16:24:47.1516287Z  	
2026-10-15T16:24:47.1516338Z  		UPDATE recipes
2026-10-15T16:24:47.1516393Z  		SET product_id = NULL
2026-10-15T16:24:47.1516447Z  		WHERE product_id = OLD.id;
2026-10-15T16:24:47.1516495Z  	
2026-10-15T16:24:47.1516548Z  		DELETE FROM meal_plan
2026-10-15T16:24:47.1516604Z  		WHERE product_id = OLD.id
2026-10-15T16:24:47.1516660Z  			AND type = 'product';
2026-10-15T16:24:47.1516706Z  	
2026-10-15T16:24:47.1516760Z  		DELETE FROM shopping_list
2026-10-15T16:24:47.1516815Z  		WHERE product_id = OLD.id;
2026-10-15T16:24:47.1516861Z  	
2026-10-15T16:24:47.1516917Z  		DELETE FROM userfield_values
2026-10-15T16:24:47.1516973Z  		WHERE object_id = OLD.id::text
2026-10-15T16:24:47.1517083Z  			AND field_id IN (SELECT id FROM userfields WHERE entity = 'products');
2026-10-15T16:24:47.1517131Z  	
2026-10-15T16:24:47.1517192Z  		DELETE FROM product_substitutions
2026-10-15T16:24:47.1517248Z  		WHERE from_product_id = OLD.id
2026-10-15T16:24:47.1517303Z  			OR to_product_id = OLD.id;
2026-10-15T16:24:47.1517349Z  	
2026-10-15T16:24:47.1517396Z  		RETURN NULL;
2026-10-15T16:24:47.1517507Z  	END;
2026-10-15T16:24:47.1517562Z  	$$ LANGUAGE plpgsql;
