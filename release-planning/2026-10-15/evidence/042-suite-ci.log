2026-10-15T16:24:47.1507470Z  	            INTO sample;
2026-10-15T16:24:47.1507987Z  	            report := report || format(E'\n - products.%s: %s rows reference missing %s. Sample (product id, %s): %s. List all: SELECT p.id, p.%s FROM products p LEFT JOIN %s t ON t.id = p.%s WHERE p.%s IS NOT NULL AND t.id IS NULL ORDER BY p.id;', ref.col, dangling_count, ref.tbl, ref.col, sample, ref.col, ref.tbl, ref.col, ref.col);
2026-10-15T16:24:47.1508053Z  	            total := total + dangling_count;
2026-10-15T16:24:47.1508229Z  	        END IF;
