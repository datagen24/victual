2026-10-15T16:24:47.1540097Z  	    FROM chores
2026-10-15T16:24:47.1540237Z  	    WHERE consume_product_on_execution NOT IN (0, 1);
2026-10-15T16:24:47.1540285Z  	
2026-10-15T16:24:47.1540409Z  	    IF bad_count > 0 THEN
2026-10-15T16:24:47.1540562Z  	        SELECT string_agg(format('(%s, %s, %s)', id, name, consume_product_on_execution), ', ' ORDER BY id)
2026-10-15T16:24:47.1540620Z  	        INTO sample FROM (
2026-10-15T16:24:47.1540703Z  	            SELECT id, name, consume_product_on_execution
2026-10-15T16:24:47.1540754Z  	            FROM chores
2026-10-15T16:24:47.1540840Z  	            WHERE consume_product_on_execution NOT IN (0, 1)
2026-10-15T16:24:47.1540898Z  	            ORDER BY id LIMIT 10
2026-10-15T16:24:47.1540946Z  	        ) bad;
2026-10-15T16:24:47.1541331Z  	        RAISE EXCEPTION 'Migration refused: % chores have a consume_product_on_execution that is not 0 or 1. Sample (chore id, name, value): %. Choose an explicit repair and rerun migration. No chore has been changed.', bad_count, sample
2026-10-15T16:24:47.1541581Z  	            USING HINT = 'List all: SELECT id, name, consume_product_on_execution FROM chores WHERE consume_product_on_execution NOT IN (0, 1) ORDER BY id;';
2026-10-15T16:24:47.1541630Z  	    END IF;
2026-10-15T16:24:47.1541679Z  	END $$;
2026-10-15T16:24:47.1541724Z  	
