2026-10-15T16:24:47.1566089Z  	--     application's lazy reclassification (StockLineage) and by the importer.
2026-10-15T16:24:47.1566223Z  	--   - stock_lineage_violations(): invariants I1 to I3, checked by this migration, by the
2026-10-15T16:24:47.1566283Z  	--     importer and by the tests.
2026-10-15T16:24:47.1566424Z  	--   - trg_cascade_change_qu_id_stock() redefined to rescale both new tables with `stock` and
2026-10-15T16:24:47.1566517Z  	--     `stock_log` (ADR-0036 section 3, unit conversion).
2026-10-15T16:24:47.1566566Z  	--
2026-10-15T16:24:47.1566707Z  	-- WHAT IT DOES NOT CHANGE. No column of `stock`, `stock_log`, `stock_entry_origins` or `labels`
2026-10-15T16:24:47.1566846Z  	-- and no row of them: the backfill reads them and writes only the two new tables. No view.
2026-10-15T16:24:47.1566937Z  	-- No wire contract: neither table is an exposed entity.
2026-10-15T16:24:47.1566986Z  	--
2026-10-15T16:24:47.1567131Z  	-- NO TEMPORARY TABLES. The application role cannot create them (deploy/postgres/roles.sql
2026-10-15T16:24:47.1567281Z  	-- revokes ALL on the database from PUBLIC), and the lazy path runs as that role, so the backfill
2026-10-15T16:24:47.1567389Z  	-- is one statement over CTEs instead of the spike's temporary tables.
2026-10-15T16:24:47.1567438Z  	--
2026-10-15T16:24:47.1567591Z  	-- CORRUPT INPUT. A non-finite amount (NaN or +/-Infinity, which `stock_amount_non_negative_check`
2026-10-15T16:24:47.1567732Z  	-- admits) in `stock` or `stock_log` cannot be attributed and makes the backfill raise, which
2026-10-15T16:24:47.1567867Z  	-- rolls this migration back. So does any I1, I2 or I3 violation left after the backfill.
2026-10-15T16:24:47.1567917Z  	--
2026-10-15T16:24:47.1568068Z  	-- RERUNNABLE. The backfill classifies only families with no contribution and no allocation, so
2026-10-15T16:24:47.1568134Z  	-- a second run writes nothing.
2026-10-15T16:24:47.1568183Z  	
2026-10-15T16:24:47.1568304Z  	CREATE TABLE stock_row_lots (
2026-10-15T16:24:47.1568396Z  		id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
2026-10-15T16:24:47.1568508Z  		stock_row_id INTEGER NOT NULL REFERENCES stock (id) ON DELETE CASCADE,
2026-10-15T16:24:47.1568617Z  		-- NULL: the row's unattributed pool, quantity whose lot is unknown.
2026-10-15T16:24:47.1568711Z  		lot_id INTEGER REFERENCES stock_log (id) ON DELETE CASCADE,
2026-10-15T16:24:47.1568833Z  		amount DOUBLE PRECISION NOT NULL CHECK (amount > 0 AND amount < 'Infinity'),
2026-10-15T16:24:47.1568944Z  		basis TEXT NOT NULL CHECK (basis IN ('recorded', 'derived', 'unknown')),
2026-10-15T16:24:47.1569077Z  		CONSTRAINT stock_row_lots_row_lot UNIQUE NULLS NOT DISTINCT (stock_row_id, lot_id),
2026-10-15T16:24:47.1569217Z  		CONSTRAINT stock_row_lots_pool_iff_unknown CHECK ((lot_id IS NULL) = (basis = 'unknown'))
2026-10-15T16:24:47.1569266Z  	);
2026-10-15T16:24:47.1569366Z  	CREATE INDEX ix_stock_row_lots_lot ON stock_row_lots (lot_id);
2026-10-15T16:24:47.1569415Z  	
2026-10-15T16:24:47.1569479Z  	CREATE TABLE stock_booking_lots (
2026-10-15T16:24:47.1569567Z  		id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
2026-10-15T16:24:47.1569679Z  		booking_id INTEGER NOT NULL REFERENCES stock_log (id) ON DELETE CASCADE,
2026-10-15T16:24:47.1569782Z  		-- NULL: a recorded draw on (or return to) the unattributed pool.
2026-10-15T16:24:47.1569874Z  		lot_id INTEGER REFERENCES stock_log (id) ON DELETE CASCADE,
2026-10-15T16:24:47.1570041Z  		amount DOUBLE PRECISION NOT NULL CHECK (amount <> 0 AND amount > '-Infinity' AND amount < 'Infinity'),
2026-10-15T16:24:47.1570151Z  		basis TEXT NOT NULL CHECK (basis IN ('recorded', 'derived', 'unknown')),
2026-10-15T16:24:47.1570294Z  		CONSTRAINT stock_booking_lots_booking_lot UNIQUE NULLS NOT DISTINCT (booking_id, lot_id),
2026-10-15T16:24:47.1570505Z  		-- An 'unknown' basis marks a lot whose units cannot be located; the pool itself is only
2026-10-15T16:24:47.1570668Z  		-- ever drawn on by a recorded booking.
2026-10-15T16:24:47.1570820Z  		CONSTRAINT stock_booking_lots_pool_recorded CHECK (lot_id IS NOT NULL OR basis = 'recorded')
2026-10-15T16:24:47.1570870Z  	);
2026-10-15T16:24:47.1571000Z  	CREATE INDEX ix_stock_booking_lots_lot ON stock_booking_lots (lot_id, booking_id);
2026-10-15T16:24:47.1571046Z  	
2026-10-15T16:24:47.1571203Z  	-- An addition booking introduces a lot. stock-edit-new also does when it raises a row, but only
2026-10-15T16:24:47.1571358Z  	-- a lineage-aware writer knows that; legacy history treats it as a movement of the family's lot.
2026-10-15T16:24:47.1571508Z  	CREATE FUNCTION stock_log_is_addition(p_type TEXT, p_amount DOUBLE PRECISION) RETURNS BOOLEAN
2026-10-15T16:24:47.1571566Z  	LANGUAGE sql IMMUTABLE AS $$
2026-10-15T16:24:47.1571735Z  		SELECT p_type IN ('purchase', 'self-production') OR (p_type = 'inventory-correction' AND p_amount > 0)
2026-10-15T16:24:47.1571787Z  	$$;
2026-10-15T16:24:47.1571832Z  	
2026-10-15T16:24:47.1571960Z  	-- A booking's signed effect on its family's quantity, as invariant I3 counts it.
2026-10-15T16:24:47.1572135Z  	CREATE FUNCTION stock_log_lineage_delta(p_type TEXT, p_amount DOUBLE PRECISION) RETURNS DOUBLE PRECISION
2026-10-15T16:24:47.1572196Z  	LANGUAGE sql IMMUTABLE AS $$
2026-10-15T16:24:47.1579795Z  		SELECT CASE p_type
2026-10-15T16:24:47.1579876Z  			WHEN 'stock-edit-old' THEN -p_amount
2026-10-15T16:24:47.1579942Z  			WHEN 'product-opened' THEN 0
2026-10-15T16:24:47.1580006Z  			WHEN 'stock-measured-new' THEN 0
2026-10-15T16:24:47.1580068Z  			WHEN 'stock-measured-old' THEN 0
2026-10-15T16:24:47.1580122Z  			ELSE p_amount END
2026-10-15T16:24:47.1580172Z  	$$;
2026-10-15T16:24:47.1580220Z  	
2026-10-15T16:24:47.1580461Z  	-- Families: a tag plus the tags stock_entry_origins links to it, per product. Only families
2026-10-15T16:24:47.1580609Z  	-- without any lineage data are returned, so the backfill never mixes `derived` rows into what a
2026-10-15T16:24:47.1580678Z  	-- lineage-aware writer recorded.
2026-10-15T16:24:47.1580904Z  	CREATE FUNCTION stock_lineage_families(p_product INTEGER DEFAULT NULL)
2026-10-15T16:24:47.1581020Z  	RETURNS TABLE (product_id INTEGER, stock_id TEXT, root TEXT, class TEXT)
2026-10-15T16:24:47.1581077Z  	LANGUAGE sql STABLE AS $$
2026-10-15T16:24:47.1581128Z  		WITH ids AS (
2026-10-15T16:24:47.1581287Z  			SELECT s.product_id, s.stock_id FROM stock s WHERE p_product IS NULL OR s.product_id = p_product
2026-10-15T16:24:47.1581339Z  			UNION
2026-10-15T16:24:47.1581419Z  			SELECT l.product_id, l.stock_id FROM stock_log l
2026-10-15T16:24:47.1581543Z  			WHERE (p_product IS NULL OR l.product_id = p_product) AND l.stock_id IS NOT NULL
2026-10-15T16:24:47.1581594Z  		), fam AS (
2026-10-15T16:24:47.1581716Z  			SELECT i.product_id, i.stock_id, COALESCE(o.origin_stock_id, i.stock_id) AS root
2026-10-15T16:24:47.1581822Z  			FROM ids i LEFT JOIN stock_entry_origins o ON o.stock_id = i.stock_id
2026-10-15T16:24:47.1581876Z  		), tracked AS (
2026-10-15T16:24:47.1581940Z  			SELECT DISTINCT f.product_id, f.root
2026-10-15T16:24:47.1581990Z  			FROM fam f
2026-10-15T16:24:47.1582123Z  			WHERE EXISTS (SELECT 1 FROM stock s JOIN stock_row_lots rl ON rl.stock_row_id = s.id
2026-10-15T16:24:47.1582225Z  					WHERE s.product_id = f.product_id AND s.stock_id = f.stock_id)
2026-10-15T16:24:47.1582361Z  				OR EXISTS (SELECT 1 FROM stock_log l JOIN stock_booking_lots bl ON bl.booking_id = l.id
2026-10-15T16:24:47.1582458Z  					WHERE l.product_id = f.product_id AND l.stock_id = f.stock_id)
2026-10-15T16:24:47.1582509Z  		), live AS (
2026-10-15T16:24:47.1582673Z  			SELECT f.product_id, f.root, l.amount, stock_log_is_addition(l.transaction_type, l.amount) AS is_add,
2026-10-15T16:24:47.1582774Z  				stock_log_lineage_delta(l.transaction_type, l.amount) AS delta
2026-10-15T16:24:47.1582902Z  			FROM stock_log l JOIN fam f ON f.stock_id = l.stock_id AND f.product_id = l.product_id
2026-10-15T16:24:47.1583044Z  			WHERE l.undone = 0
2026-10-15T16:24:47.1583095Z  		), b AS (
2026-10-15T16:24:47.1583160Z  			SELECT live.product_id, live.root,
2026-10-15T16:24:47.1583230Z  				count(*) FILTER (WHERE is_add) AS n_add,
2026-10-15T16:24:47.1583328Z  				COALESCE(sum(amount) FILTER (WHERE is_add), 0) AS sum_add,
2026-10-15T16:24:47.1583402Z  				count(*) FILTER (WHERE NOT is_add) AS n_other,
2026-10-15T16:24:47.1583464Z  				COALESCE(sum(delta), 0) AS delta_sum
2026-10-15T16:24:47.1583539Z  			FROM live GROUP BY live.product_id, live.root
2026-10-15T16:24:47.1583588Z  		), r AS (
2026-10-15T16:24:47.1583727Z  			SELECT f.product_id, f.root, count(s.id) AS n_rows, COALESCE(sum(s.amount), 0) AS rows_sum
2026-10-15T16:24:47.1583858Z  			FROM fam f LEFT JOIN stock s ON s.stock_id = f.stock_id AND s.product_id = f.product_id
2026-10-15T16:24:47.1583918Z  			GROUP BY f.product_id, f.root
2026-10-15T16:24:47.1583967Z  		), stat AS (
2026-10-15T16:24:47.1584027Z  			SELECT r.product_id, r.root,
2026-10-15T16:24:47.1584078Z  				CASE
2026-10-15T16:24:47.1584166Z  					WHEN COALESCE(b.n_add, 0) = 0 AND r.n_rows = 0 THEN 'N'
2026-10-15T16:24:47.1584326Z  					WHEN COALESCE(b.n_add, 0) = 1 AND stock_amounts_equal(COALESCE(b.delta_sum, 0), r.rows_sum) THEN 'E'
2026-10-15T16:24:47.1584441Z  					WHEN COALESCE(b.n_add, 0) >= 2 AND COALESCE(b.n_other, 0) = 0 AND r.n_rows = 1
2026-10-15T16:24:47.1584530Z  						AND stock_amounts_equal(b.sum_add, r.rows_sum) THEN 'X'
2026-10-15T16:24:47.1584585Z  					ELSE 'U' END AS class
2026-10-15T16:24:47.1584691Z  			FROM r LEFT JOIN b ON b.product_id = r.product_id AND b.root = r.root
2026-10-15T16:24:47.1584739Z  		)
2026-10-15T16:24:47.1584817Z  		SELECT f.product_id, f.stock_id, f.root, st.class
2026-10-15T16:24:47.1584868Z  		FROM fam f
2026-10-15T16:24:47.1584969Z  		JOIN stat st ON st.product_id = f.product_id AND st.root = f.root
2026-10-15T16:24:47.1585123Z  		WHERE NOT EXISTS (SELECT 1 FROM tracked t WHERE t.product_id = f.product_id AND t.root = f.root)
2026-10-15T16:24:47.1585172Z  	$$;
2026-10-15T16:24:47.1585220Z  	
2026-10-15T16:24:47.1585364Z  	-- The backfill. One statement, so every part reads the same snapshot of which families are
2026-10-15T16:24:47.1585554Z  	-- untracked. Writes nothing to stock, stock_log, stock_entry_origins or labels.
2026-10-15T16:24:47.1585700Z  	--   E: every row of the family is a contribution of the one live addition; every booking of the
2026-10-15T16:24:47.1585812Z  	--      family, live or undone, is allocated to it (an addition to itself).
2026-10-15T16:24:47.1585946Z  	--   X: the one row holds each live addition's amount; only the additions are allocated.
2026-10-15T16:24:47.1586072Z  	--   U: each row becomes one pool contribution; each live addition gets an `unknown`
2026-10-15T16:24:47.1586154Z  	--      self-allocation; other bookings stay untracked.
2026-10-15T16:24:47.1586207Z  	--   N: nothing.
2026-10-15T16:24:47.1586320Z  	CREATE FUNCTION stock_lineage_backfill(p_product INTEGER DEFAULT NULL)
2026-10-15T16:24:47.1586430Z  	RETURNS TABLE (family_class TEXT, families BIGINT, stock_rows BIGINT)
2026-10-15T16:24:47.1586489Z  	LANGUAGE plpgsql AS $$
2026-10-15T16:24:47.1586538Z  	DECLARE
2026-10-15T16:24:47.1586591Z  		v_bad TEXT;
2026-10-15T16:24:47.1586641Z  	BEGIN
2026-10-15T16:24:47.1586718Z  		SELECT 'stock row ' || s.id INTO v_bad FROM stock s
2026-10-15T16:24:47.1586898Z  		WHERE (p_product IS NULL OR s.product_id = p_product) AND s.amount IN ('NaN', 'Infinity', '-Infinity') LIMIT 1;
2026-10-15T16:24:47.1586953Z  		IF v_bad IS NULL THEN
2026-10-15T16:24:47.1587037Z  			SELECT 'booking ' || l.id INTO v_bad FROM stock_log l
2026-10-15T16:24:47.1587207Z  			WHERE (p_product IS NULL OR l.product_id = p_product) AND l.amount IN ('NaN', 'Infinity', '-Infinity') LIMIT 1;
2026-10-15T16:24:47.1587257Z  		END IF;
2026-10-15T16:24:47.1587314Z  		IF v_bad IS NOT NULL THEN
2026-10-15T16:24:47.1587468Z  			RAISE EXCEPTION 'ADR-0036 backfill: % has a non-finite amount and cannot be attributed', v_bad;
2026-10-15T16:24:47.1587514Z  		END IF;
2026-10-15T16:24:47.1587624Z  	
2026-10-15T16:24:47.1587675Z  		RETURN QUERY
2026-10-15T16:24:47.1587732Z  		WITH fam AS MATERIALIZED (
2026-10-15T16:24:47.1587813Z  			SELECT * FROM stock_lineage_families(p_product)
2026-10-15T16:24:47.1587871Z  		), lots AS MATERIALIZED (
2026-10-15T16:24:47.1588007Z  			SELECT DISTINCT f.product_id, f.root, f.class, l.id AS lot_id, l.amount AS lot_amount
2026-10-15T16:24:47.1588135Z  			FROM fam f JOIN stock_log l ON l.stock_id = f.stock_id AND l.product_id = f.product_id
2026-10-15T16:24:47.1588285Z  			WHERE f.class IN ('E', 'X') AND l.undone = 0 AND stock_log_is_addition(l.transaction_type, l.amount)
2026-10-15T16:24:47.1588338Z  		), ins_rows AS (
2026-10-15T16:24:47.1588441Z  			INSERT INTO stock_row_lots (stock_row_id, lot_id, amount, basis)
2026-10-15T16:24:47.1588581Z  			SELECT s.id, lo.lot_id, CASE WHEN f.class = 'E' THEN s.amount ELSE lo.lot_amount END, 'derived'
2026-10-15T16:24:47.1588632Z  			FROM stock s
2026-10-15T16:24:47.1588735Z  			JOIN fam f ON f.stock_id = s.stock_id AND f.product_id = s.product_id
2026-10-15T16:24:47.1588840Z  			JOIN lots lo ON lo.product_id = f.product_id AND lo.root = f.root
2026-10-15T16:24:47.1588894Z  			WHERE s.amount > 0
2026-10-15T16:24:47.1588945Z  			RETURNING 1
2026-10-15T16:24:47.1588997Z  		), ins_pool AS (
2026-10-15T16:24:47.1589096Z  			INSERT INTO stock_row_lots (stock_row_id, lot_id, amount, basis)
2026-10-15T16:24:47.1589160Z  			SELECT s.id, NULL, s.amount, 'unknown'
2026-10-15T16:24:47.1589284Z  			FROM stock s JOIN fam f ON f.stock_id = s.stock_id AND f.product_id = s.product_id
2026-10-15T16:24:47.1589346Z  			WHERE f.class = 'U' AND s.amount > 0
2026-10-15T16:24:47.1589398Z  			RETURNING 1
2026-10-15T16:24:47.1589449Z  		), ins_bookings AS (
2026-10-15T16:24:47.1589553Z  			INSERT INTO stock_booking_lots (booking_id, lot_id, amount, basis)
2026-10-15T16:24:47.1589605Z  			SELECT l.id,
2026-10-15T16:24:47.1589718Z  				CASE WHEN stock_log_is_addition(l.transaction_type, l.amount) THEN l.id
2026-10-15T16:24:47.1589873Z  					ELSE (SELECT lo.lot_id FROM lots lo WHERE lo.product_id = f.product_id AND lo.root = f.root) END,
2026-10-15T16:24:47.1589924Z  				l.amount,
2026-10-15T16:24:47.1590114Z  				CASE WHEN f.class IN ('E', 'X') THEN 'derived' ELSE 'unknown' END
2026-10-15T16:24:47.1590244Z  			FROM stock_log l JOIN fam f ON f.stock_id = l.stock_id AND f.product_id = l.product_id
2026-10-15T16:24:47.1590306Z  			WHERE l.amount <> 0 AND f.class <> 'N'
2026-10-15T16:24:47.1590492Z  				AND (f.class = 'E' OR stock_log_is_addition(l.transaction_type, l.amount))
2026-10-15T16:24:47.1590543Z  			RETURNING 1
2026-10-15T16:24:47.1590593Z  		), counts AS (
2026-10-15T16:24:47.1590776Z  			SELECT (SELECT count(*) FROM ins_rows) + (SELECT count(*) FROM ins_pool) + (SELECT count(*) FROM ins_bookings) AS n
2026-10-15T16:24:47.1590826Z  		)
2026-10-15T16:24:47.1590917Z  		SELECT f.class, count(DISTINCT (f.product_id, f.root)),
2026-10-15T16:24:47.1591106Z  			(SELECT count(*) FROM stock s JOIN fam g ON g.stock_id = s.stock_id AND g.product_id = s.product_id WHERE g.class = f.class)
2026-10-15T16:24:47.1591167Z  		FROM fam f CROSS JOIN counts
2026-10-15T16:24:47.1591226Z  		GROUP BY f.class, counts.n;
2026-10-15T16:24:47.1591277Z  	END
2026-10-15T16:24:47.1591323Z  	$$;
2026-10-15T16:24:47.1591372Z  	
2026-10-15T16:24:47.1591515Z  	-- Invariants I1 to I3 of ADR-0036 section 3, for one product or all. Empty when they hold.
2026-10-15T16:24:47.1591626Z  	--   I1: a row with amount > 0 holds contributions summing to its amount.
2026-10-15T16:24:47.1591734Z  	--   I2: a booking with allocations has allocations summing to its amount.
2026-10-15T16:24:47.1591865Z  	--   I3: a lot with a `recorded` or `derived` allocation has live allocations (counted as
2026-10-15T16:24:47.1591988Z  	--       stock_log_lineage_delta() counts bookings) summing to its contributions.
2026-10-15T16:24:47.1592105Z  	CREATE FUNCTION stock_lineage_violations(p_product INTEGER DEFAULT NULL)
2026-10-15T16:24:47.1592272Z  	RETURNS TABLE (invariant TEXT, subject_id INTEGER, expected DOUBLE PRECISION, actual DOUBLE PRECISION)
2026-10-15T16:24:47.1592421Z  	LANGUAGE sql STABLE AS $$
2026-10-15T16:24:47.1592513Z  		SELECT 'I1', s.id, s.amount, COALESCE(sum(rl.amount), 0)
2026-10-15T16:24:47.1592617Z  		FROM stock s LEFT JOIN stock_row_lots rl ON rl.stock_row_id = s.id
2026-10-15T16:24:47.1592701Z  		WHERE (p_product IS NULL OR s.product_id = p_product)
2026-10-15T16:24:47.1592759Z  		GROUP BY s.id, s.amount
2026-10-15T16:24:47.1592957Z  		HAVING (s.amount > 0 OR count(rl.id) > 0) AND NOT COALESCE(stock_amounts_equal(s.amount, COALESCE(sum(rl.amount), 0)), false)
2026-10-15T16:24:47.1593008Z  		UNION ALL
2026-10-15T16:24:47.1593074Z  		SELECT 'I2', l.id, l.amount, sum(bl.amount)
2026-10-15T16:24:47.1593178Z  		FROM stock_log l JOIN stock_booking_lots bl ON bl.booking_id = l.id
2026-10-15T16:24:47.1593262Z  		WHERE p_product IS NULL OR l.product_id = p_product
2026-10-15T16:24:47.1593320Z  		GROUP BY l.id, l.amount
2026-10-15T16:24:47.1593432Z  		HAVING NOT COALESCE(stock_amounts_equal(l.amount, sum(bl.amount)), false)
2026-10-15T16:24:47.1593484Z  		UNION ALL
2026-10-15T16:24:47.1593560Z  		SELECT 'I3', n.lot_id, n.net, COALESCE(h.held, 0)
2026-10-15T16:24:47.1593611Z  		FROM (
2026-10-15T16:24:47.1593740Z  			SELECT bl.lot_id, sum(stock_log_lineage_delta(l.transaction_type, bl.amount)) AS net
2026-10-15T16:24:47.1593846Z  			FROM stock_booking_lots bl JOIN stock_log l ON l.id = bl.booking_id
2026-10-15T16:24:47.1593915Z  			JOIN stock_log lot ON lot.id = bl.lot_id
2026-10-15T16:24:47.1594072Z  			WHERE l.undone = 0 AND bl.basis <> 'unknown' AND (p_product IS NULL OR lot.product_id = p_product)
2026-10-15T16:24:47.1594237Z  				AND NOT EXISTS (SELECT 1 FROM stock_booking_lots u WHERE u.lot_id = bl.lot_id AND u.basis = 'unknown')
2026-10-15T16:24:47.1594293Z  			GROUP BY bl.lot_id
2026-10-15T16:24:47.1594343Z  		) n
2026-10-15T16:24:47.1594391Z  		LEFT JOIN (
2026-10-15T16:24:47.1594567Z  			SELECT rl.lot_id, sum(rl.amount) AS held FROM stock_row_lots rl WHERE rl.lot_id IS NOT NULL GROUP BY rl.lot_id
2026-10-15T16:24:47.1594627Z  		) h ON h.lot_id = n.lot_id
2026-10-15T16:24:47.1594826Z  		WHERE NOT COALESCE(stock_amounts_equal(n.net, COALESCE(h.held, 0)), false)
2026-10-15T16:24:47.1594874Z  	$$;
2026-10-15T16:24:47.1594925Z  	
2026-10-15T16:24:47.1594972Z  	
2026-10-15T16:24:47.1595115Z  	-- trg_cascade_change_qu_id_stock, as 0294 left it, plus the rescale of both new tables. The
2026-10-15T16:24:47.1595230Z  	-- trigger declaration (db/pgsql/baseline/06_triggers_a.sql) is unchanged.
2026-10-15T16:24:47.1595358Z  	CREATE OR REPLACE FUNCTION trg_cascade_change_qu_id_stock() RETURNS TRIGGER AS $$
2026-10-15T16:24:47.1595407Z  	DECLARE
2026-10-15T16:24:47.1595466Z  		v_factor DOUBLE PRECISION;
2026-10-15T16:24:47.1595513Z  	BEGIN
2026-10-15T16:24:47.1595613Z  		-- All amounts anywhere are related to the products stock QU,
2026-10-15T16:24:47.1595740Z  		-- so apply the appropriate unit conversion to all amounts everywhere on change
2026-10-15T16:24:47.1595888Z  		-- (and enforce that such a conversion need to exist when the product was once added to stock)
2026-10-15T16:24:47.1595937Z  	
2026-10-15T16:24:47.1596069Z  		-- (the "AND NEW.qu_id_stock != OLD.qu_id_stock" from the original stock_log subquery is
2026-10-15T16:24:47.1596194Z  		-- dropped here - it is guaranteed true already by this trigger's WHEN clause)
2026-10-15T16:24:47.1596245Z  		IF NOT EXISTS(
2026-10-15T16:24:47.1596292Z  				SELECT 1
2026-10-15T16:24:47.1596362Z  				FROM quantity_unit_conversions_resolved
2026-10-15T16:24:47.1596421Z  				WHERE product_id = NEW.id
2026-10-15T16:24:47.1596480Z  					AND from_qu_id = OLD.qu_id_stock
2026-10-15T16:24:47.1596541Z  					AND to_qu_id = NEW.qu_id_stock
2026-10-15T16:24:47.1596590Z  			)
2026-10-15T16:24:47.1596641Z  			AND EXISTS(
2026-10-15T16:24:47.1596690Z  				SELECT 1
2026-10-15T16:24:47.1596741Z  				FROM stock_log
2026-10-15T16:24:47.1596799Z  				WHERE product_id = NEW.id
2026-10-15T16:24:47.1596846Z  			)
2026-10-15T16:24:47.1596893Z  		THEN
2026-10-15T16:24:47.1597147Z  			RAISE EXCEPTION 'qu_id_stock can only be changed when a corresponding QU conversion (old QU => new QU) exists when the product was once added to stock';
2026-10-15T16:24:47.1597260Z  		END IF;
2026-10-15T16:24:47.1597308Z  	
2026-10-15T16:24:47.1597609Z  		v_factor := COALESCE((SELECT factor FROM quantity_unit_conversions_resolved WHERE product_id = NEW.id AND from_qu_id = OLD.qu_id_stock AND to_qu_id = NEW.qu_id_stock LIMIT 1), 1.0);
2026-10-15T16:24:47.1597658Z  	
2026-10-15T16:24:47.1597797Z  		-- Issue #546: refuse before touching anything, mirroring MergeProducts()'s own guard
2026-10-15T16:24:47.1597937Z  		-- (services/StockService.php) against the same stock_measurement_coherence_check. A
2026-10-15T16:24:47.1598073Z  		-- factor of 1 leaves every amount unchanged and can never violate it, so only a genuine
2026-10-15T16:24:47.1598208Z  		-- rescale is refused. `stock` only, not `stock_log` - see this file's header comment
2026-10-15T16:24:47.1598334Z  		-- for why checking the ledger here would lock the product's unit permanently.
2026-10-15T16:24:47.1598391Z  		IF v_factor != 1.0
2026-10-15T16:24:47.1598530Z  			AND EXISTS(SELECT 1 FROM stock WHERE product_id = NEW.id AND opened_amount IS NOT NULL)
2026-10-15T16:24:47.1598580Z  		THEN
2026-10-15T16:24:47.1598789Z  			RAISE EXCEPTION 'qu_id_stock cannot be changed by a non-1 conversion factor while this product has a measured open container';
2026-10-15T16:24:47.1598838Z  		END IF;
2026-10-15T16:24:47.1598884Z  	
2026-10-15T16:24:47.1598935Z  		UPDATE chores
2026-10-15T16:24:47.1599015Z  		SET product_amount = product_amount * v_factor
2026-10-15T16:24:47.1599070Z  		WHERE product_id = NEW.id;
2026-10-15T16:24:47.1599117Z  	
2026-10-15T16:24:47.1599169Z  		UPDATE meal_plan
2026-10-15T16:24:47.1599245Z  		SET product_amount = product_amount * v_factor
2026-10-15T16:24:47.1599300Z  		WHERE type = 'product'
2026-10-15T16:24:47.1599357Z  			AND product_id = NEW.id;
2026-10-15T16:24:47.1599405Z  	
2026-10-15T16:24:47.1599460Z  		UPDATE recipes_pos
2026-10-15T16:24:47.1599520Z  		SET amount = amount * v_factor
2026-10-15T16:24:47.1599577Z  		WHERE product_id = NEW.id;
2026-10-15T16:24:47.1599624Z  	
2026-10-15T16:24:47.1599736Z  		UPDATE shopping_list
2026-10-15T16:24:47.1599795Z  		SET amount = amount * v_factor
2026-10-15T16:24:47.1599852Z  		WHERE product_id = NEW.id
2026-10-15T16:24:47.1599909Z  			AND product_id IS NOT NULL;
2026-10-15T16:24:47.1599954Z  	
2026-10-15T16:24:47.1600004Z  		UPDATE stock
2026-10-15T16:24:47.1600064Z  		SET amount = amount * v_factor,
2026-10-15T16:24:47.1600119Z  			price = price / v_factor
2026-10-15T16:24:47.1600172Z  		WHERE product_id = NEW.id;
2026-10-15T16:24:47.1600219Z  	
2026-10-15T16:24:47.1600271Z  		UPDATE stock_log
2026-10-15T16:24:47.1600401Z  		SET amount = amount * v_factor,
2026-10-15T16:24:47.1600459Z  			price = price / v_factor
2026-10-15T16:24:47.1600514Z  		WHERE product_id = NEW.id;
2026-10-15T16:24:47.1600561Z  	
2026-10-15T16:24:47.1600707Z  		-- ADR-0036 section 3: contributions and allocations are amounts in the stock unit too, and
2026-10-15T16:24:47.1600853Z  		-- I1 to I3 compare them with stock.amount and stock_log.amount, so they rescale by the same
2026-10-15T16:24:47.1600921Z  		-- factor in the same transaction.
2026-10-15T16:24:47.1600979Z  		UPDATE stock_row_lots rl
2026-10-15T16:24:47.1601037Z  		SET amount = rl.amount * v_factor
2026-10-15T16:24:47.1601088Z  		FROM stock s
2026-10-15T16:24:47.1601148Z  		WHERE s.id = rl.stock_row_id
2026-10-15T16:24:47.1601203Z  			AND s.product_id = NEW.id;
2026-10-15T16:24:47.1601253Z  	
2026-10-15T16:24:47.1601311Z  		UPDATE stock_booking_lots bl
2026-10-15T16:24:47.1601369Z  		SET amount = bl.amount * v_factor
2026-10-15T16:24:47.1601418Z  		FROM stock_log l
2026-10-15T16:24:47.1601474Z  		WHERE l.id = bl.booking_id
2026-10-15T16:24:47.1601529Z  			AND l.product_id = NEW.id;
2026-10-15T16:24:47.1601574Z  	
2026-10-15T16:24:47.1601712Z  		-- Issue #543: product_location_min_stock.min_stock_amount (migrations/0276.pgsql.sql)
2026-10-15T16:24:47.1601846Z  		-- is stored in the product's stock unit exactly like the amounts above, and belongs in
2026-10-15T16:24:47.1602071Z  		-- the same transaction as the rest of this rescale. A different table than the row
2026-10-15T16:24:47.1602216Z  		-- this trigger is mid-UPDATE on, so it needs its own UPDATE (unlike products.min_stock_amount
2026-10-15T16:24:47.1602269Z  		-- just below).
2026-10-15T16:24:47.1602329Z  		UPDATE product_location_min_stock
2026-10-15T16:24:47.1602410Z  		SET min_stock_amount = min_stock_amount * v_factor
2026-10-15T16:24:47.1602463Z  		WHERE product_id = NEW.id;
2026-10-15T16:24:47.1602510Z  	
2026-10-15T16:24:47.1602637Z  		-- Issue #543: products.min_stock_amount is the same class of miss - stored in the
2026-10-15T16:24:47.1602769Z  		-- product's own stock unit, never rescaled. This is the row already being updated, so
2026-10-15T16:24:47.1602889Z  		-- it is set directly on NEW rather than through a second UPDATE, exactly the way
2026-10-15T16:24:47.1603012Z  		-- trg_cascade_change_qu_id_stock2 (migrations/0275.pgsql.sql) already rescales
2026-10-15T16:24:47.1603114Z  		-- quick_consume_amount and quick_open_amount on this same row.
2026-10-15T16:24:47.1603205Z  		NEW.min_stock_amount := NEW.min_stock_amount * v_factor;
2026-10-15T16:24:47.1603252Z  	
2026-10-15T16:24:47.1603304Z  		RETURN NEW;
2026-10-15T16:24:47.1603352Z  	END;
2026-10-15T16:24:47.1603408Z  	$$ LANGUAGE plpgsql;
2026-10-15T16:24:47.1603453Z  	
2026-10-15T16:24:47.1603602Z  	-- Backfill and validate. Migrations run in a transaction, so a raise here rolls this whole
2026-10-15T16:24:47.1603666Z  	-- migration back, tables included.
2026-10-15T16:24:47.1603713Z  	DO $$
2026-10-15T16:24:47.1603761Z  	DECLARE
2026-10-15T16:24:47.1603814Z  		v_violation RECORD;
2026-10-15T16:24:47.1603863Z  	BEGIN
2026-10-15T16:24:47.1603928Z  		PERFORM stock_lineage_backfill(NULL);
2026-10-15T16:24:47.1604038Z  		SELECT * INTO v_violation FROM stock_lineage_violations(NULL) LIMIT 1;
2026-10-15T16:24:47.1604089Z  		IF FOUND THEN
2026-10-15T16:24:47.1604241Z  			RAISE EXCEPTION 'ADR-0036 backfill left invariant % violated for % % (expected %, found %)',
2026-10-15T16:24:47.1604299Z  				v_violation.invariant,
2026-10-15T16:24:47.1604531Z  				CASE v_violation.invariant WHEN 'I1' THEN 'stock row' WHEN 'I2' THEN 'booking' ELSE 'lot' END,
2026-10-15T16:24:47.1604646Z  				v_violation.subject_id, v_violation.expected, v_violation.actual;
2026-10-15T16:24:47.1604695Z  		END IF;
2026-10-15T16:24:47.1604740Z  	END
2026-10-15T16:24:47.1604787Z  	$$;
