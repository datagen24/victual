{
  "name": "victual-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP sidecar for Victual — see docs/mcp-interface-spec.md",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "victual-mcp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
