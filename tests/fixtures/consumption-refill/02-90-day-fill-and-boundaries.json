{
	"title": "A 90-day fill: 76 days after the fill, and the boundaries around the warning and reorder dates",
	"adr_sequence": "90-day fill, section 2 and 4",
	"description": "A fill of 90 days on 2026-01-01 gives 2026-03-18 (76 days after the fill) and a warning date of 2026-03-11. The cases are R-8, R-7, R-1, R and R+3 with a lead of seven days.",
	"setup": {
		"users": [
			"alice"
		],
		"recipes": {
			"main": {
				"owner": "alice",
				"shares": {}
			}
		}
	},
	"steps": [
		{
			"note": "Record a 90-day fill",
			"as": "alice",
			"request": {
				"method": "POST",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill/fills?as_of=2026-03-01",
				"body": {
					"filled_on": "2026-01-01",
					"supplied_days": 90
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"status": "ok",
					"estimate": {
						"reorder_date": "2026-03-18",
						"warning_date": "2026-03-11",
						"source": "fallback",
						"lead_days": 7,
						"reason": null
					}
				}
			}
		},
		{
			"note": "R - 8",
			"as": "alice",
			"request": {
				"method": "GET",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-10"
			},
			"expect": {
				"status": 200,
				"body": {
					"status": "ok",
					"days_overdue": null
				}
			}
		},
		{
			"note": "R - 7",
			"as": "alice",
			"request": {
				"method": "GET",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-11"
			},
			"expect": {
				"status": 200,
				"body": {
					"status": "approaching",
					"days_overdue": null
				}
			}
		},
		{
			"note": "R - 1",
			"as": "alice",
			"request": {
				"method": "GET",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-17"
			},
			"expect": {
				"status": 200,
				"body": {
					"status": "approaching"
				}
			}
		},
		{
			"note": "R",
			"as": "alice",
			"request": {
				"method": "GET",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-18"
			},
			"expect": {
				"status": 200,
				"body": {
					"status": "due",
					"days_overdue": 0
				}
			}
		},
		{
			"note": "R + 3",
			"as": "alice",
			"request": {
				"method": "GET",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-21"
			},
			"expect": {
				"status": 200,
				"body": {
					"status": "due",
					"days_overdue": 3
				}
			}
		},
		{
			"note": "A lead of 0 removes the approaching period",
			"as": "alice",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-17",
				"body": {
					"warning_lead_days": 0
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"settings": {
						"rule": null,
						"warning_lead_days": 0
					}
				}
			}
		},
		{
			"note": "With a lead of 0, R - 1 is ok",
			"as": "alice",
			"request": {
				"method": "GET",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-17"
			},
			"expect": {
				"status": 200,
				"body": {
					"status": "ok",
					"estimate": {
						"warning_date": "2026-03-18",
						"lead_days": 0
					}
				}
			}
		},
		{
			"note": "and R is due",
			"as": "alice",
			"request": {
				"method": "GET",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill?as_of=2026-03-18"
			},
			"expect": {
				"status": 200,
				"body": {
					"status": "due"
				}
			}
		},
		{
			"note": "A lead of 61 is refused",
			"as": "alice",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill",
				"body": {
					"warning_lead_days": 61
				}
			},
			"expect": {
				"status": 422,
				"body": {
					"error": "invalid_lead"
				}
			}
		},
		{
			"note": "A lead of -1 is refused",
			"as": "alice",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/recipes/{{recipe.main}}/refill",
				"body": {
					"warning_lead_days": -1
				}
			},
			"expect": {
				"status": 422,
				"body": {
					"error": "invalid_lead"
				}
			}
		}
	]
}
