{
	"title": "A manual consumption, the same dose imported, then link: one deduction",
	"adr_sequence": "12",
	"description": "The import books on its own and the response suggests the manual transaction in possible_duplicates; it never merges by itself. When the person links them (resolve action link with the manual transaction_id), the import's own booking is undone and the event is linked to the manual one, leaving a single deduction.",
	"setup": {
		"locations": ["organizer_a"],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": 10
				}
			}
		}
	},
	"steps": [
		{
			"note": "The person has a one-line recipe for the same product",
			"request": {
				"method": "POST",
				"path": "/api/consumption/recipes",
				"body": {
					"name": "One tablet",
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 1, "qu_id": "{{unit}}"}
					]
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"created_object_id": "{{any}}"
				}
			},
			"save": {
				"recipe": "created_object_id"
			}
		},
		{
			"note": "The person approves a mapping on the native approval screen",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:42",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": null,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:42",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "The person consumes the recipe by hand in Victual",
			"request": {
				"method": "POST",
				"path": "/api/consumption/recipes/{{saved.recipe}}/consume",
				"body": {
					"request_id": "manual-0001",
					"occurred_at": "{{time:-10m}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"state": "booked",
					"transaction_id": "{{any}}"
				}
			},
			"save": {
				"manual_tx": "transaction_id"
			},
			"stock": {
				"tablet": 9
			}
		},
		{
			"note": "The same dose arrives from the device",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-5m}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"reason": null,
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 1, "location_id": "{{location.organizer_a}}"}
					],
					"possible_duplicates": [
						{"transaction_id": "{{saved.manual_tx}}"}
					]
				}
			},
			"stock": {
				"tablet": 8
			}
		},
		{
			"note": "The person says they are the same dose",
			"request": {
				"method": "POST",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9/resolve",
				"body": {
					"action": "link",
					"transaction_id": "{{saved.manual_tx}}"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"state": "linked",
					"transaction_id": "{{saved.manual_tx}}",
					"possible_duplicates": []
				}
			},
			"stock": {
				"tablet": 9
			}
		},
		{
			"note": "A replay of a linked event stays linked",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-5m}}"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "linked",
					"replayed": true
				}
			},
			"stock": {
				"tablet": 9
			}
		},
		{
			"note": "Linking again is refused",
			"request": {
				"method": "POST",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9/resolve",
				"body": {
					"action": "link",
					"transaction_id": "{{saved.manual_tx}}"
				}
			},
			"expect": {
				"status": 409,
				"body": {
					"error": "invalid_transition"
				}
			},
			"stock": {
				"tablet": 9
			}
		}
	]
}
