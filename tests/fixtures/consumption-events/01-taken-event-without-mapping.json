{
	"title": "A taken event with no approved mapping is stored and books nothing",
	"adr_sequence": "1",
	"description": "The first event for a medication arrives before the person has approved a mapping. The server keeps it as needs_mapping so nothing is lost, deducts no stock, and lists it for the review inbox.",
	"setup": {
		"locations": ["organizer_a"],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": 10
				}
			}
		}
	},
	"steps": [
		{
			"note": "First submission for an unmapped medication",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-90m}}",
					"source_updated_at": "{{time:-90m}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "needs_mapping",
					"reason": null,
					"lines": []
				}
			},
			"stock": {
				"tablet": 10
			}
		},
		{
			"note": "Read it back",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "needs_mapping",
					"reason": null,
					"lines": []
				}
			}
		},
		{
			"note": "The review inbox lists it",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events?state=needs_mapping"
			},
			"expect": {
				"status": 200,
				"body": [
					{"source_system": "healthkit", "source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9", "state": "needs_mapping"}
				],
				"count": {
					"": 1
				}
			},
			"stock": {
				"tablet": 10
			}
		}
	]
}
