{
	"title": "Bulk void by filter handles 50, 50 and 20 events, reporting remaining 70, 20, 0",
	"adr_sequence": "9f",
	"description": "120 events are booked in three batches of 40 and then reported not_logged ten days after the dose, so each becomes needs_review/source_deleted. One bulk void by filter, repeated until remaining is 0, restores all 130 tablets. The events are given decreasing occurred_at in booking order because bulk resolution takes the oldest occurred_at first and an earlier booking cannot be undone under a later one (ADR-0036); see README, \"Known behaviour\".",
	"setup": {
		"locations": ["organizer_a"],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": 130
				}
			}
		}
	},
	"steps": [
		{
			"note": "The person approves a mapping on the native approval screen",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:42",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": null,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:42",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
