{
	"title": "An event with no quantity books the mapping's default_quantity, or needs review",
	"adr_sequence": "9c",
	"description": "The server never invents a quantity. With default_quantity 2 the event books 2. A mapping without one makes the event needs_review/quantity_missing; once the person gives the mapping a default and retries, it books.",
	"setup": {
		"locations": ["organizer_a"],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": 10
				}
			}
		}
	},
	"steps": [
		{
			"note": "Mapping with default_quantity 2",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:42",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": 2,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:42",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "Mapping without a default for a second medication",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:43",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": null,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:43",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "No quantity, mapping has a default",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"occurred_at": "{{time:-90m}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 2}
					]
				}
			},
			"stock": {
				"tablet": 8
			}
		},
		{
			"note": "No quantity, mapping has none",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:43",
					"occurred_at": "{{time:-90m}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "needs_review",
					"reason": "quantity_missing",
					"lines": []
				}
			},
			"stock": {
				"tablet": 8
			}
		},
		{
			"note": "The person adds a default quantity of 1",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:43",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": 1,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:43",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "Retry books the default",
			"request": {
				"method": "POST",
				"path": "/api/consumption/events/healthkit/6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9/resolve",
				"body": {
					"action": "retry"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"state": "booked",
					"lines": [
						{"amount": 1}
					]
				}
			},
			"stock": {
				"tablet": 7
			}
		}
	]
}
