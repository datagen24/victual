{
	"title": "One item in the wrong state does not stop a bulk resolve",
	"adr_sequence": "9g",
	"description": "Bulk keep over three events, one of which is already voided. The voided one reports http_status 409 invalid_transition inside results; the other two apply. The bulk call itself answers 200.",
	"setup": {
		"locations": ["organizer_a"],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": 10
				}
			}
		}
	},
	"steps": [
		{
			"note": "The person approves a mapping on the native approval screen",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:42",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": null,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:42",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "Dose A",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-10d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"reason": null,
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 1, "location_id": "{{location.organizer_a}}"}
					]
				}
			}
		},
		{
			"note": "Dose B",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-10d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"reason": null,
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 1, "location_id": "{{location.organizer_a}}"}
					]
				}
			}
		},
		{
			"note": "Dose C (booked last, so it is the one voided first)",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-10d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"reason": null,
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 1, "location_id": "{{location.organizer_a}}"}
					]
				}
			},
			"stock": {
				"tablet": 7
			}
		},
		{
			"note": "Deleted with no reason: event 1",
			"request": {
				"method": "DELETE",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "needs_review",
					"reason": "source_deleted"
				}
			}
		},
		{
			"note": "Deleted with no reason: event 2",
			"request": {
				"method": "DELETE",
				"path": "/api/consumption/events/healthkit/6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "needs_review",
					"reason": "source_deleted"
				}
			}
		},
		{
			"note": "Deleted with no reason: event 3",
			"request": {
				"method": "DELETE",
				"path": "/api/consumption/events/healthkit/6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "needs_review",
					"reason": "source_deleted"
				}
			}
		},
		{
			"note": "A person voids dose C on its own",
			"request": {
				"method": "POST",
				"path": "/api/consumption/events/healthkit/6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9/resolve",
				"body": {
					"action": "void"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"state": "voided"
				}
			},
			"stock": {
				"tablet": 8
			}
		},
		{
			"note": "Bulk keep over A, B and the already voided C",
			"request": {
				"method": "POST",
				"path": "/api/consumption/events/resolve",
				"body": {
					"action": "keep",
					"events": [
						{"source_system": "healthkit", "source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9"},
						{"source_system": "healthkit", "source_event_id": "6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9"},
						{"source_system": "healthkit", "source_event_id": "6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9"}
					]
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"results": [
						{
							"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
							"http_status": 200,
							"event": {
								"state": "booked"
							}
						},
						{
							"source_event_id": "6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
							"http_status": 200,
							"event": {
								"state": "booked"
							}
						},
						{
							"source_event_id": "6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9",
							"http_status": 409,
							"error": {
								"error": "invalid_transition"
							}
						}
					]
				},
				"count": {
					"results": 3
				}
			},
			"stock": {
				"tablet": 8
			}
		},
		{
			"note": "C stays voided",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events/healthkit/6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "voided"
				}
			}
		},
		{
			"note": "A was kept",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked"
				}
			}
		}
	]
}
