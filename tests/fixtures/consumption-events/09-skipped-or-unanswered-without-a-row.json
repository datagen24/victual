{
	"title": "Skipped, unanswered, scheduled and not_logged events with no row create no row",
	"adr_sequence": "9",
	"description": "A dose that was never taken is never stored: the response is no_consumption (200, not 201) and a later GET finds nothing. A scheduled dose alone never generates consumption.",
	"setup": {
		"locations": ["organizer_a"],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": 10
				}
			}
		}
	},
	"steps": [
		{
			"note": "The person approves a mapping on the native approval screen",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:42",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": null,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:42",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "skipped",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "skipped",
					"medication_ref": "hk:med:42",
					"occurred_at": "{{time:-90m}}"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "no_consumption",
					"reason": null
				}
			},
			"stock": {
				"tablet": 10
			}
		},
		{
			"note": "unanswered",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "unanswered",
					"medication_ref": "hk:med:42",
					"occurred_at": "{{time:-90m}}"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "no_consumption",
					"reason": null
				}
			},
			"stock": {
				"tablet": 10
			}
		},
		{
			"note": "scheduled",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "scheduled",
					"medication_ref": "hk:med:42",
					"occurred_at": "{{time:+30m}}"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0003-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "no_consumption",
					"reason": null
				}
			},
			"stock": {
				"tablet": 10
			}
		},
		{
			"note": "not_logged",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0004-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "not_logged",
					"medication_ref": "hk:med:42"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0004-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "no_consumption",
					"reason": null
				}
			},
			"stock": {
				"tablet": 10
			}
		},
		{
			"note": "No row exists for the skipped event",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 404,
				"body": {
					"error": "not_found"
				}
			}
		},
		{
			"note": "The inbox is empty",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events"
			},
			"expect": {
				"status": 200,
				"body": []
			},
			"stock": {
				"tablet": 10
			}
		}
	]
}
