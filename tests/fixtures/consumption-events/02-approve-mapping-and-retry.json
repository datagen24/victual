{
	"title": "Approving a mapping and retrying books once, at the mapped location",
	"adr_sequence": "2",
	"description": "The person approves a mapping (product, unit label, fixed location organizer_a) and resolves the waiting event with retry. Stock falls by one at organizer_a only; organizer_b is untouched.",
	"setup": {
		"locations": ["organizer_a", "organizer_b"],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": 10,
					"organizer_b": 5
				}
			}
		}
	},
	"steps": [
		{
			"note": "Event arrives before any mapping exists",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-90m}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "needs_mapping"
				}
			},
			"stock": {
				"tablet": 15
			}
		},
		{
			"note": "The person approves a mapping on the native approval screen",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:42",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": ["tablet"],
					"default_quantity": null,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:42",
					"unit_labels": ["tablet"],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "Retry with the current mapping",
			"request": {
				"method": "POST",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9/resolve",
				"body": {
					"action": "retry"
				}
			},
			"expect": {
				"status": 200,
				"body": {
					"state": "booked",
					"reason": null,
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 1, "location_id": "{{location.organizer_a}}"}
					],
					"transaction_id": "{{any}}",
					"revision": 1
				}
			},
			"stock": {
				"tablet": 14,
				"tablet@organizer_a": 9,
				"tablet@organizer_b": 5
			}
		},
		{
			"note": "Read it back",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"reason": null,
					"lines": [
						{"product_id": "{{product.tablet}}", "amount": 1, "location_id": "{{location.organizer_a}}"}
					],
					"transaction_id": "{{any}}"
				}
			}
		}
	]
}
