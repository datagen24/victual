{
	"title": "A correction spans revived stock and multiple purchase rows",
	"adr_sequence": "6-split-lines",
	"description": "Correct one tablet to four across purchases of two and three tablets. Line totals remain four, independent of allocation splits; GET preserves the result.",
	"setup": {
		"locations": [
			"organizer_a"
		],
		"products": {
			"tablet": {
				"stock": {
					"organizer_a": [
						2,
						3
					]
				}
			}
		}
	},
	"steps": [
		{
			"note": "The person approves a mapping on the native approval screen",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/mappings/healthkit/hk:med:42",
				"body": {
					"product_id": "{{product.tablet}}",
					"quantity_factor": 1,
					"unit_labels": [
						"tablet"
					],
					"default_quantity": null,
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					},
					"effective_from": "{{time:-30d}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"medication_ref": "hk:med:42",
					"unit_labels": [
						"tablet"
					],
					"location": {
						"mode": "fixed",
						"location_id": "{{location.organizer_a}}"
					}
				}
			}
		},
		{
			"note": "Original sample, 1 tablet",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 1,
					"unit_label": "tablet",
					"occurred_at": "{{time:-90m}}"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"reason": null,
					"lines": [
						{
							"product_id": "{{product.tablet}}",
							"amount": 1,
							"location_id": "{{location.organizer_a}}"
						}
					]
				}
			},
			"stock": {
				"tablet": 4
			}
		},
		{
			"note": "Replace with four tablets across purchase rows",
			"request": {
				"method": "PUT",
				"path": "/api/consumption/events/healthkit/6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
				"body": {
					"status": "taken",
					"medication_ref": "hk:med:42",
					"quantity": 4,
					"unit_label": "tablet",
					"occurred_at": "{{time:-90m}}",
					"replaces": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9"
				}
			},
			"expect": {
				"status": 201,
				"body": {
					"source_system": "healthkit",
					"source_event_id": "6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9",
					"state": "booked",
					"replaces": {
						"source_event_id": "6F1C0001-9B6E-4F3A-8A1D-2B7C5E90A1A9",
						"state": "voided"
					}
				},
				"line_totals": [
					{
						"product_id": "{{product.tablet}}",
						"location_id": "{{location.organizer_a}}",
						"amount": 4
					}
				]
			},
			"stock": {
				"tablet": 1
			}
		},
		{
			"note": "Read the persisted correction",
			"request": {
				"method": "GET",
				"path": "/api/consumption/events/healthkit/6F1C0002-9B6E-4F3A-8A1D-2B7C5E90A1A9"
			},
			"expect": {
				"status": 200,
				"body": {
					"state": "booked"
				},
				"line_totals": [
					{
						"product_id": "{{product.tablet}}",
						"location_id": "{{location.organizer_a}}",
						"amount": 4
					}
				]
			},
			"stock": {
				"tablet": 1
			}
		}
	]
}
