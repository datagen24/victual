#!/usr/bin/env bash
#
# The parity suite: does this fork still behave like the grocy it forked from?
#
#   .devtools/parity/bin/parity all         build what is missing, boot both, run everything
#   .devtools/parity/bin/parity up          boot both stacks and leave them running
#   .devtools/parity/bin/parity api         the API scenarios
#   .devtools/parity/bin/parity ui          the browser walk
#   .devtools/parity/bin/parity side-effects  MQTT and InfluxDB (fork-only, no upstream)
#   .devtools/parity/bin/parity cli <tool> [args…]  one of the app's bin/ entry points
#   .devtools/parity/bin/parity reset       throw both databases away and re-migrate
#   .devtools/parity/bin/parity status      what is running
#   .devtools/parity/bin/parity logs <name> podman logs for one container (app|web|upstream|…)
#   .devtools/parity/bin/parity year       a simulated year (--plan-only for now)
#   .devtools/parity/bin/parity clock-check the simulated-time acceptance matrix
#   .devtools/parity/bin/parity psql <sql…> a read-only query against the parity postgres
#   .devtools/parity/bin/parity down        stop everything and delete the volumes
#
# This is the *other* differential suite and the difference matters. `.devtools/pgsql/`
# asks whether this fork behaves the same on SQLite as on PostgreSQL — an internal
# question, answered by driving SQL at both engines. This one asks whether the fork behaves
# the same as **upstream grocy 4.6.0**, which is the version version.json says this tree
# forked from, and answers it by driving the HTTP surface of two running instances. Neither
# subsumes the other: the pgsql suite would pass on a fork that had quietly changed an API
# response on both engines, and this one would pass on a fork whose SQLite path was broken,
# because there is no SQLite path left to break (ADR-0008).
#
# See ../README.md for what a difference here means and what to do with one.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARITY_ROOT="$(cd "$HERE/.." && pwd)"
REPO_ROOT="$(cd "$PARITY_ROOT/../.." && pwd)"

# shellcheck source=../stack/stack.sh
source "$PARITY_ROOT/stack/stack.sh"

HARNESS="$PARITY_ROOT/harness"
REPORTS="${PARITY_REPORTS:-$PARITY_ROOT/reports}"

VICTUAL_URL="http://127.0.0.1:${VICTUAL_PORT}"
UPSTREAM_URL="http://127.0.0.1:${UPSTREAM_PORT}"

# --- Prerequisites ------------------------------------------------------------------------

require_node() {
	command -v node >/dev/null 2>&1 || die "node is not on PATH (Node 18 or newer — the harness uses built-in fetch)"
	local major
	major="$(node -p 'process.versions.node.split(".")[0]')"
	[ "$major" -ge 18 ] || die "node $major is too old; the harness uses the built-in fetch (Node 18+)"
}

ensure_harness_deps() {
	require_node
	if [ ! -d "$HARNESS/node_modules/playwright" ]; then
		log "installing the harness's one dependency (playwright)"
		( cd "$HARNESS" && npm install --no-audit --no-fund )
	fi
}

# The fork side is the three Nix images, built from this working tree, so they are the
# thing under test and have to be rebuilt when the tree changes. `--build` forces it;
# otherwise existing images are reused, because a build this long on every run is how a
# suite stops being run.
#
# This used to build the `Dockerfile`'s `production` target. That stage was removed when
# ADR-0013 was accepted on 2026-09-04 — the production images are `flake.nix`'s — and
# issue #56 was the port. What changed is not only which command builds: the artifact is
# now three images rather than one, and `stack/stack.sh` boots them the way
# `deploy/podman/victual.yaml` does. The suite compares upstream against what the fork
# actually ships instead of against an image it does not.
#
# **Two build routes, and the host decides which.** `nix run .#load` is the direct one and
# needs Nix able to produce Linux artifacts — true on a Linux host, and on a Mac only with
# a Linux builder configured (nix/README.md, option B). Everything else goes through
# `nix/build-in-podman.sh images`, which builds inside a podman container running the
# official Nix image and keeps a warm store between runs. Both end in `podman load`, and
# both write the same tags.
build_victual_images() {
	if [ "$(uname -s)" = "Linux" ] && command -v nix >/dev/null 2>&1; then
		log "building the Nix images (nix run .#load)"
		CONTAINER_ENGINE="$ENGINE" nix run "$REPO_ROOT#load" \
			|| die "nix run .#load failed — see nix/README.md"
	else
		log "building the Nix images inside podman (nix/build-in-podman.sh images)"
		log "the first run is slow; the builder keeps its store, later runs are not"
		CONTAINER_ENGINE="$ENGINE" "$REPO_ROOT/nix/build-in-podman.sh" images \
			|| die "nix/build-in-podman.sh images failed — see nix/README.md"
	fi
}

ensure_victual_images() {
	local force="${1:-no}"
	local missing=()
	local image

	for image in "$VICTUAL_APP_IMAGE" "$VICTUAL_WEB_IMAGE" "$VICTUAL_MIGRATE_IMAGE"; do
		"$ENGINE" image exists "$image" 2>/dev/null || missing+=("$image")
	done

	if [ "$force" = "force" ] || [ "${#missing[@]}" -gt 0 ]; then
		if [ "${#missing[@]}" -gt 0 ]; then
			log "not loaded yet: ${missing[*]}"
		fi
		build_victual_images
	else
		log "reusing victual-{app,web,migrate}:${VICTUAL_VERSION} (pass --build to rebuild from the current tree)"
	fi

	# The build is only half of it: `podman load` names the images from the streamer's own
	# metadata, so a version.json the tags do not match is a suite that boots the previous
	# build without saying so. Fail on the tag rather than on a confusing diff later.
	for image in "$VICTUAL_APP_IMAGE" "$VICTUAL_WEB_IMAGE" "$VICTUAL_MIGRATE_IMAGE"; do
		"$ENGINE" image exists "$image" 2>/dev/null \
			|| die "$image is still not present after the build — check the tag against version.json ($VICTUAL_VERSION)"
	done
}

ensure_upstream_image() {
	if ! "$ENGINE" image exists "$UPSTREAM_IMAGE" 2>/dev/null; then
		log "pulling $UPSTREAM_IMAGE"
		"$ENGINE" pull "$UPSTREAM_IMAGE"
	fi
}

# --- Phases -------------------------------------------------------------------------------

phase_api() {
	ensure_harness_deps
	log "API scenarios"
	node "$HARNESS/run-api.js" \
		--victual "$VICTUAL_URL" \
		--upstream "$UPSTREAM_URL" \
		--upstream-image "$UPSTREAM_IMAGE" \
		--out "$REPORTS" \
		"$@"
}

phase_ui() {
	ensure_harness_deps
	log "browser walk"
	node "$HARNESS/run-ui.js" \
		--victual "$VICTUAL_URL" \
		--upstream "$UPSTREAM_URL" \
		--out "$REPORTS" \
		"$@"
}

phase_side_effects() {
	ensure_harness_deps
	log "fork-only side effects (MQTT, InfluxDB)"
	# `bin/victual-publish-state` is the one thing here with no HTTP surface, so the harness
	# has to be told how to run it. It used to `podman exec` into the single Victual
	# container; there is no such container now, and neither serving image has a shell, a
	# PATH or a plain PHP CLI to exec into. `parity cli` runs it from the migrate image
	# instead — which is where a deployment would run it from too.
	PARITY_INFLUX_TOKEN="$INFLUX_TOKEN" \
	PARITY_INFLUX_ORG="$INFLUX_ORG" \
	PARITY_INFLUX_BUCKET="$INFLUX_BUCKET" \
	PARITY_PUBLISH_CMD="'$HERE/parity' cli victual-publish-state --quiet" \
	node "$HARNESS/run-side-effects.js" \
		--victual "$VICTUAL_URL" \
		--mqtt "127.0.0.1:${MQTT_PORT}" \
		--influx "http://127.0.0.1:${INFLUX_PORT}" \
		--out "$REPORTS" \
		"$@"
}

# The three phases run in a fixed order and **the order is load-bearing**: `api` is what
# puts data into both instances, so the browser walk has tables with rows in them and the
# MQTT check has a stock level to publish. Running `ui` against a cold stack compares two
# empty applications, which is a comparison that cannot fail and therefore proves nothing.
#
# Every phase runs even when an earlier one failed. A partial report from three phases is
# worth more than a complete report from one, and the exit code still reflects the worst.
phase_all() {
	local rc=0
	phase_api          || rc=1
	phase_ui           || rc=1
	phase_side_effects || rc=1
	return "$rc"
}

usage() {
	# tail -n +2 drops the shebang, which `grep '^#'` would otherwise print as
	# "!/usr/bin/env bash" at the top of the help.
	tail -n +2 "${BASH_SOURCE[0]}" | grep '^#' | head -17 | sed 's/^# \{0,1\}//'
}

# --- Dispatch -------------------------------------------------------------------------------

BUILD=no
ARGS=()
for arg in "$@"; do
	case "$arg" in
		--build) BUILD=force ;;
		*) ARGS+=("$arg") ;;
	esac
done
set -- "${ARGS[@]:-}"

case "${1:-all}" in
	up)
		ensure_victual_images "$BUILD"
		ensure_upstream_image
		stack_up
		;;
	year)
		shift
		ensure_harness_deps
		# No stack is booted here yet: the generator is offline by construction, which is
		# what makes the year reviewable before anything runs. Replay lands in the next
		# stage and will reset the stack first, because the year needs a virgin database
		# for its two id sequences to start level.
		node "$HARNESS/run-year.js" --out "$REPORTS" "$@"
		;;
	psql)
		shift
		[ $# -gt 0 ] || die "psql needs a statement, e.g. parity psql 'SELECT count(*) FROM outbox'"
		pg_query "$@"
		;;
	clock-check)
		shift
		# Runs as its own process on purpose: the clock is a boot-time property — the
		# timestamp file has to exist before PostgreSQL initialises — and this shell has
		# already sourced stack.sh with faketime off. Re-sourcing it here would leave two
		# sets of argument builders disagreeing about whether the stack is faked.
		exec "$HERE/clock-check" "$@"
		;;
	down)
		stack_down
		;;
	reset)
		stack_reset
		;;
	status)
		stack_status
		;;
	logs)
		shift || true
		# `victual` used to be one container and is now two. It still resolves, to the app
		# tier, because that is where a PHP error goes — but `web` is where an nginx or
		# FastCGI failure goes, and a 502 is read from there.
		name="${1:-app}"
		case "$name" in
			victual|app) name=victual-app ;;
			web)         name=victual-web ;;
		esac
		"$ENGINE" logs --tail 200 "${PARITY_PREFIX}-${name}"
		;;
	api)
		shift || true
		phase_api "$@"
		;;
	ui)
		shift || true
		phase_ui "$@"
		;;
	side-effects)
		shift || true
		phase_side_effects "$@"
		;;
	cli)
		shift || true
		[ "$#" -gt 0 ] || die "cli needs a tool name, e.g. '$0 cli victual-publish-state --quiet'"
		victual_cli "$@"
		;;
	all)
		ensure_victual_images "$BUILD"
		ensure_upstream_image
		stack_up
		phase_all
		;;
	-h|--help|help)
		usage
		;;
	*)
		die "unknown command '${1}' — try '$0 --help'"
		;;
esac
