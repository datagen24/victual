                "def": "CHECK ((kind = ANY (ARRAY['location'::text, 'product'::text, 'stock_entry'::text, 'recipe'::text, 'chore'::text, 'battery'::text])))"
            },
            {
                "conname": "labels_pkey",
                "def": "PRIMARY KEY (uid)"
            },
            {
                "conname": "labels_uid_check",
                "def": "CHECK ((uid ~ '^[0-9A-F][0-9A-HJKMNP-TV-Z]{12}$'::text))"
            }
