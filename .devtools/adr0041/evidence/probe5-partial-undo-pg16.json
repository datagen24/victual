    "2_one_line_two_bookings": [
        {
            "step": "booked",
            "effective_state": "booked",
            "bookings_for_line_1": 2
        },
        {
            "step": "undo the older booking of line 1 first (the two bookings come from different lots)",
            "result": "accepted",
            "effective_state": "needs_review/partially_undone"
        },
        {
            "step": "undo the newer booking of line 1",
            "result": "accepted",
            "effective_state": "needs_review/partially_undone"
        },
        {
            "step": "undo the older booking again (already undone)",
            "result": "refused",
            "class": "Exception",
            "message": "Booking does not exist or was already undone",
            "effective_state": "needs_review/partially_undone",
            "lineage_violations": 0
        }
    ],
    "3_all_or_none_and_stuck_partial": [
        {
            "step": "UndoTransaction while line 1 has a later dependent booking",
            "result": "refused",
            "class": "Exception",
            "message": "Booking has subsequent dependent bookings, undo not possible",
            "ledger_unchanged": true,
            "effective_state": "booked"
        },
        {
            "step": "UndoBooking(line 2) alone",
            "result": "accepted",
            "effective_state": "needs_review/partially_undone",
            "lineage_violations": 0
        },
        {
            "step": "UndoTransaction again (line 1 still blocked)",
            "result": "refused",
            "class": "Exception",
            "message": "Booking has subsequent dependent bookings, undo not possible",
            "effective_state": "needs_review/partially_undone"
        }
