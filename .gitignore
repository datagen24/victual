embedded.txt
/.release
/packages
/public/packages
/.phpdoc
/.docs-build
/phpdoc.xml

# Coverage output: the per-process .cov files go to scratch, but SUITE_COVERAGE_CLOVER
# defaults to a relative path in CI and is easy to point at the working tree by hand.
/clover.xml
*.cov

# Local-only files: per-machine Claude settings (skills under .claude/ are tracked) and macOS metadata
**/.claude/settings.local.json
.DS_Store

# Nix build results
/result
/result-*

# Parity suite output and its one npm dependency
.devtools/parity/reports/
.devtools/parity/harness/node_modules/
.devtools/parity/harness/package-lock.json

# Left behind by "python3 -m unittest discover -s .devtools/ci", which the lint job runs.
__pycache__/

# Built by .devtools/parity/stack/faketime.sh: the libfaketime library and the clock file.
.devtools/parity/.faketime/

# Canonicalization corpus written by .devtools/labels/canonical-json-tests.php
.corpus.jsonl
