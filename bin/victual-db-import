#!/usr/bin/env php
<?php

// Imports an existing SQLite database into the configured target database.
//
//   php bin/victual-db-import [/path/to/victual.db] [--force]
//
// The source defaults to victual.db in the data path. The target is whatever config.php
// selects, which since ADR-0008's retirement is PostgreSQL and nothing else - this command
// is the way across.
//
// The source has to be a grocy or Victual SQLite database within the supported migration
// span (DatabaseImporter::SUPPORTED_SOURCE_MIGRATION_MIN through
// SUPPORTED_SOURCE_MIGRATION_MAX); anything outside it is refused with both numbers named.
//
// The target schema is created if it does not exist yet, so a fresh, empty PostgreSQL
// database is a valid target.

// Every refusal below writes to STDERR and exits non-zero. That is worth stating because it
// was not true until the import phase of the differential suite asserted it: `exit('...')`
// with a string argument prints the string and exits **0**, so a source file that did not
// exist, a config.php with an invalid setting, and a target that was itself SQLite each
// reported success. An operator chaining this with && carried on.

use Victual\Services\Database\DatabaseImporter;
use Victual\Services\DatabaseMigrationService;
use Victual\Services\DatabaseService;

if (PHP_SAPI !== 'cli')
{
	fwrite(STDERR, 'This is a command line script' . PHP_EOL);
	exit(1);
}

$arguments = array_slice($argv, 1);
$force = in_array('--force', $arguments, true);
$positional = array_values(array_filter($arguments, fn($a) => !str_starts_with($a, '--')));

if (!defined('VICTUAL_DATAPATH'))
{
	define('VICTUAL_DATAPATH', getenv('VICTUAL_DATAPATH') ?: __DIR__ . '/../data');
}

require_once __DIR__ . '/../packages/autoload.php';

if (in_array('--help', $arguments, true) || in_array('-h', $arguments, true))
{
	echo "Usage: php bin/victual-db-import [/path/to/victual.db] [--force]\n\n";
	echo "  Copies an existing SQLite database into the database configured in config.php.\n";
	echo '  The source must be at migration ' . DatabaseImporter::SUPPORTED_SOURCE_MIGRATION_MIN
		. ' through ' . DatabaseImporter::SUPPORTED_SOURCE_MIGRATION_MAX . ".\n";
	echo "  --force  Overwrite a target that already contains data.\n\n";
	echo "  Replacement scope: every table both engines share is replaced verbatim; a few\n";
	echo "  target tables are always kept (this engine's own configuration, print/label\n";
	echo "  history, the target's own MQTT broker state) or are cleared/repaired/recomputed\n";
	echo "  rather than copied or left alone. See DatabaseImporter's own docblock for the\n";
	echo "  exact, table-by-table list.\n";
	exit(0);
}

// config.php is optional, for the reason bin/victual-migrate states: every setting it can
// carry is also reachable as a VICTUAL_* environment variable, and a container that
// configures itself that way has no such file to require. Requiring it unconditionally made
// this command - the one an operator reaches for on exactly such a deployment - fail on a
// missing file rather than on anything to do with the import.
if (file_exists(VICTUAL_DATAPATH . '/config.php'))
{
	require_once VICTUAL_DATAPATH . '/config.php';
}

require_once __DIR__ . '/../config-dist.php';

// Migrations and the demo location fixup expect a user context
if (!defined('VICTUAL_USER_ID'))
{
	define('VICTUAL_USER_ID', 1);
}

try
{
	(new Victual\Helpers\ConfigurationValidator())->validateConfig();
}
catch (\Victual\Helpers\EInvalidConfig $ex)
{
	fwrite(STDERR, 'Invalid setting in config.php: ' . $ex->getMessage() . PHP_EOL);
	exit(1);
}

$sourcePath = $positional[0] ?? (VICTUAL_DATAPATH . '/victual.db');

if (!file_exists($sourcePath))
{
	fwrite(STDERR, 'Source database not found: ' . $sourcePath . PHP_EOL);
	exit(1);
}

$targetDialect = DatabaseService::GetInstance()->GetDialect();

if ($targetDialect->GetName() === 'sqlite')
{
	// Only reachable from the differential suite, which is the one caller that may still
	// construct a SQLite dialect (DatabaseDialect::SQLITE_TOOLING_ENV). A configured
	// installation is refused several steps earlier, by ConfigurationValidator.
	fwrite(STDERR, 'The configured database is SQLite, so there is nothing to import into.' . PHP_EOL
		. 'Set DB_DRIVER (and the DB_* connection settings) to the target engine first.' . PHP_EOL);
	exit(1);
}

echo 'Source: ' . $sourcePath . ' (sqlite)' . PHP_EOL;
echo 'Target: ' . VICTUAL_DB_NAME . ' on ' . VICTUAL_DB_HOST . ':' . VICTUAL_DB_PORT . ' (' . $targetDialect->GetName() . ')' . PHP_EOL;
echo PHP_EOL;

try
{
	// Schema only. A target created from a baseline is otherwise seeded with the rows a
	// fresh installation starts from - an admin user, the permission hierarchy, the
	// default quantity units - and every one of them would be a row this import is about
	// to replace, while making the target look non-empty to the overwrite check below.
	echo 'Making sure the target schema is up to date...' . PHP_EOL;
	DatabaseMigrationService::GetInstance()->MigrateDatabase(false);

	$source = new \PDO('sqlite:' . $sourcePath);
	$source->setAttribute(\PDO::ATTR_ERRMODE, \PDO::ERRMODE_EXCEPTION);

	// Deliberately NOT PDO::NULL_EMPTY_STRING, which the application sets on its own
	// connections: it would turn every empty string in the database into NULL on the way
	// through, which is both lossy and enough to violate a NOT NULL column. grocy really
	// does store empty strings - meal_plan_sections holds the internal section with an
	// empty name.
	$source->setAttribute(\PDO::ATTR_ORACLE_NULLS, \PDO::NULL_NATURAL);

	$target = DatabaseService::GetInstance()->GetDbConnectionRaw();

	echo 'Copying...' . PHP_EOL;
	$importer = new DatabaseImporter($source, $target, $targetDialect, function ($message)
	{
		echo $message . PHP_EOL;
	});

	$report = $importer->Import($force);

	echo PHP_EOL . 'Imported ' . array_sum($report) . ' rows across ' . count($report) . ' tables.' . PHP_EOL;
	exit(0);
}
catch (\Exception $ex)
{
	fwrite(STDERR, PHP_EOL . 'Import failed: ' . $ex->getMessage() . PHP_EOL);
	exit(1);
}
