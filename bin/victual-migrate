#!/usr/bin/env php
<?php

// Brings the configured database up to date, then exits.
//
//   php bin/victual-migrate [--quiet]
//
// Which database that is comes from config.php, exactly as it does for the web
// application: SQLite unless DB_DRIVER says otherwise. Set VICTUAL_DATAPATH to point the
// SQLite path somewhere else.
//
// This exists so that migrating is something you *do*, rather than something that
// happens to whoever sends the first request after a deployment. That matters in two
// places: an initContainer can run it before any pod serves traffic, and the
// differential test suite can build a schema without standing up a web server. See
// docs/plans/landed/10-cold-start-statelessness.md.
//
// Concurrent runs are serialised on a PostgreSQL session level advisory lock, so two
// pods starting together are safe. That lock lives on the connection that took it, which
// means this command has to reach PostgreSQL over a DIRECT connection or through a pool
// entry in session mode. Behind a transaction-mode pooler (pgbouncer's default) the
// unlock can land on a different backend than the lock and leak it permanently, wedging
// every later migration run - see ADR-0009's finding F1, and the docblock on
// PostgresDialect::WithMigrationLock().
//
// Exit codes: 0 on success (including "already up to date"), 1 on failure.

use Victual\Services\DatabaseMigrationService;
use Victual\Services\DatabaseService;

if (PHP_SAPI !== 'cli')
{
	exit('This is a command line script');
}

$arguments = array_slice($argv, 1);
$quiet = in_array('--quiet', $arguments, true);

if (in_array('--help', $arguments, true) || in_array('-h', $arguments, true))
{
	echo "Usage: php bin/victual-migrate [--quiet]\n\n";
	echo "  Runs any outstanding migrations against the database configured in config.php\n";
	echo "  and exits. Safe to run repeatedly; a database that is already up to date is a\n";
	echo "  no-op.\n\n";
	echo "  A database that was empty comes out ready to log into, with the admin account,\n";
	echo "  the permission hierarchy and the default master data of a new installation. Use\n";
	echo "  bin/victual-db-import instead to move an existing SQLite installation across.\n\n";
	echo "  The admin account's password is VICTUAL_BOOTSTRAP_ADMIN_PASSWORD when that is set.\n";
	echo "  Otherwise one is generated, printed once to stderr, and must be changed at first\n";
	echo "  login.\n\n";
	echo "  --quiet  Only print errors.\n";
	exit(0);
}

if (!defined('VICTUAL_DATAPATH'))
{
	define('VICTUAL_DATAPATH', getenv('VICTUAL_DATAPATH') ?: __DIR__ . '/../data');
}

require_once __DIR__ . '/../packages/autoload.php';

// The data directory is created when it does not exist. The shipped data/ covers the
// default, but pointing VICTUAL_DATAPATH somewhere new is the normal way to build a
// throwaway database, and without this that fails with a raw PDO "unable to open
// database file" rather than anything a reader could act on.
if (!is_dir(VICTUAL_DATAPATH) && !@mkdir(VICTUAL_DATAPATH, 0755, true) && !is_dir(VICTUAL_DATAPATH))
{
	fwrite(STDERR, 'Could not create the data directory: ' . VICTUAL_DATAPATH . PHP_EOL);
	exit(1);
}

// config.php is optional here in a way it is not for the web application: a migration
// run against an otherwise untouched checkout is a normal thing to want, and demanding
// a config file before the defaults can be used would make the test suite carry one
// around for no reason.
if (file_exists(VICTUAL_DATAPATH . '/config.php'))
{
	require_once VICTUAL_DATAPATH . '/config.php';
}

require_once __DIR__ . '/../config-dist.php';

// Migrations and the always-run 8888.php fixup expect a user context.
if (!defined('VICTUAL_USER_ID'))
{
	define('VICTUAL_USER_ID', 1);
}

try
{
	(new Victual\Helpers\ConfigurationValidator())->validateConfig();
}
catch (\Victual\Helpers\EInvalidConfig $ex)
{
	fwrite(STDERR, 'Invalid setting in config.php: ' . $ex->getMessage() . PHP_EOL);
	exit(1);
}

$dialect = DatabaseService::GetInstance()->GetDialect();

if (!$quiet)
{
	if ($dialect->GetName() === 'sqlite')
	{
		echo 'Database: ' . $dialect->GetDbFilePath() . ' (sqlite)' . PHP_EOL;
	}
	else
	{
		echo 'Database: ' . VICTUAL_DB_NAME . ' on ' . VICTUAL_DB_HOST . ':' . VICTUAL_DB_PORT
			. ' (' . $dialect->GetName() . ')' . PHP_EOL;
	}
}

try
{
	// Printed even with --quiet, and to stderr so a redirected stdout does not swallow it:
	// on a fresh database with no VICTUAL_BOOTSTRAP_ADMIN_PASSWORD this line is the only
	// copy of the first administrator's password that exists.
	DatabaseMigrationService::GetInstance()->MigrateDatabase(true, function (string $username, string $password)
	{
		fwrite(STDERR, DatabaseMigrationService::GeneratedAdminPasswordNotice($username, $password) . PHP_EOL);
	});
}
catch (\Exception $ex)
{
	fwrite(STDERR, 'Migration failed: ' . $ex->getMessage() . PHP_EOL);
	exit(1);
}

if (!$quiet)
{
	$applied = DatabaseService::GetInstance()->GetDbConnectionRaw()
		->query('SELECT MAX(migration) FROM migrations')->fetchColumn();

	echo 'Schema is up to date at migration ' . $applied . '.' . PHP_EOL;
}

exit(0);
