#!/usr/bin/env php
<?php

// Merges duplicate stock rows, then exits.
//
//   php bin/victual-compact-stock [--product-id=N] [--quiet]
//
// This is the explicit maintenance command ADR-0033 moves stock-row compaction into
// (docs/adr/0033-stock-rows-merge-only-in-maintenance-for-non-expiring-rows.md). Before this
// command existed, StockService::CompactStockEntries() ran inline inside AddProduct(),
// EditStockEntry() and WeighLocation() - merging a purchase, an edit or a weighing into
// whatever else already matched it on every grouping column, every time. Issue #488 found
// that inline merge could delete a row an in-flight undo still depended on, silently
// discarding a live booking's units; issue #491 found it could retire a live stock_entry
// label out from under a purchase that happened to match the labelled row. Neither inline
// call remains (this command is the only caller left), and the merge itself now only
// considers rows with no real due date (best_before_date IS NULL or the 2999-12-31
// never-expires sentinel) and no live label - migrations/0290.pgsql.sql's stock_splits
// definition is the authority for exactly which rows qualify.
//
// Idempotent and safe to run repeatedly, including concurrently with ordinary bookings and
// with itself: StockService::CompactStockEntries() takes the same per-product advisory lock
// (DatabaseService::LockProductStock()) every booking path already serialises against, then
// row-level SELECT ... FOR UPDATE locks on the exact candidate rows before re-reading
// eligibility and writing, so a label issued mid-run is honoured rather than merged away
// (ADR-0033 decision 3). A run that finds nothing eligible - the ordinary case, most of the
// time - changes nothing and still exits 0.
//
// Database privileges (for ADR-0010 property 3's least-privilege split, wired up separately
// - see ADR-0033 acceptance prerequisite 3): SELECT, UPDATE, DELETE on stock; SELECT, UPDATE
// on stock_log (rewriting stock_id only - never stock_row_id, never any other column);
// SELECT, UPDATE, DELETE on stock_entry_origins (never INSERT - this command only ever
// UPDATEs an existing row's origin_stock_id or DELETEs one outright; new rows are written by
// RecordSplitOrigin(), called only from OpenProduct(), never from here); SELECT,
// UPDATE on labels (read to evaluate eligibility, write because deleting a losing row fires
// retire_stock_entry_labels - migrations/0283.pgsql.php - which UPDATEs the label it retires,
// under this same caller's privileges since the trigger function carries none of its own);
// SELECT on products (that same trigger's retirement_snapshot reads only the product name -
// not userfield_values or userfields, which round 3 wrongly kept on this list: no statement
// this command or its triggers run needs them directly, and stock_splits' own
// userfield-eligibility check runs through the view below, which reads its underlying tables
// as the view's OWNER, not this caller). Also SELECT on the views stock_splits (this
// command's own candidate-group read - CompactStockEntries()'s very first query),
// products_average_price and products_last_purchased; SELECT, INSERT, UPDATE, DELETE on
// cache__products_average_price and cache__products_last_purchased, because every stock_log
// row this command rewrites fires the stock_log_UPD trigger (trg_stock_log_UPD(),
// db/pgsql/baseline/06_triggers_b.sql), which is SECURITY INVOKER like every other trigger
// function here and so writes those two cache tables under this same caller's rights, not
// its own - and, since migrations/0292.pgsql.sql (issue #588), what it writes is no longer a
// plain upsert: trg_stock_log_UPD calls rebuild_stock_log_cache_for_product(), which
// unconditionally DELETEs the stale cache row for the product before conditionally
// re-INSERTing it from the view. DELETE is therefore required here too, alongside SELECT
// (still needed to evaluate that DELETE's own WHERE product_id = ... condition) and INSERT;
// UPDATE remains listed even though this rebuild itself no longer issues one against either
// cache table (it replaced the INSERT ... ON CONFLICT DO UPDATE upsert this comment used to
// describe), kept least-privilege-conservatively rather than narrowed as a side effect of an
// unrelated fix; and SELECT, UPDATE on system_db_changed_time - not something
// CompactStockEntries() itself touches, but the process's own exit runs DatabaseService's
// shutdown handler same as any other caller, which flushes a deferred changed-time write
// there (PostgresDialect::FlushDbChangedTime(), a bare UPDATE ... WHERE id = 1) whenever this
// run changed anything; that handler swallows any failure, so without this grant the command
// still exits 0, but polling clients relying on the changed time never see the merge. The
// MQTT state snapshot and InfluxDB booking-event drain that same shutdown handler can also
// run need no grant of their own here: both are gated behind their own on/off constant
// (VICTUAL_MQTT_ENABLED, VICTUAL_INFLUXDB_ENABLED - MqttStatePublicationService::IsEnabled(),
// InfluxEventWriter::IsEnabled()) and, off by default, run no query at all ("no class loaded,
// no query run, no connection attempted" - MqttStatePublicationService::IsEnabled()'s own
// docblock). A deployment that turns either on for this role would need to grant whatever
// that path then touches at that time; this list documents the standard, as-shipped
// configuration only. No DDL, no TRUNCATE. That is a subset of the victual_app role
// deploy/postgres/roles.sql already grants; it does not yet have a role of its own.
//
// Exit codes: 0 when the run completed (with or without anything to merge), 1 on failure.

use Victual\Services\DatabaseService;
use Victual\Services\StockService;

if (PHP_SAPI !== 'cli')
{
	exit('This is a command line script');
}

$arguments = array_slice($argv, 1);

// --help/-h is checked before anything else, and independently of whether the rest of the
// command line would otherwise be rejected below - it is the one escape hatch that must
// always work, the same way it would if it appeared alongside a typo the caller was trying
// to get help about.
if (in_array('--help', $arguments, true) || in_array('-h', $arguments, true))
{
	echo "Usage: php bin/victual-compact-stock [--product-id=N] [--quiet] [--help|-h]\n\n";
	echo "  Merges stock rows which agree on every grouping column (product, due date,\n";
	echo "  purchased date, price, open state/date, location, shopping location, note) and\n";
	echo "  are each eligible to merge: no real due date (only NULL or the 2999-12-31\n";
	echo "  never-expires sentinel), no live stock_entry label, no per-unit label prefix,\n";
	echo "  no userfield value, no measured remainder. Run it on a schedule (a CronJob is\n";
	echo "  the intended deployment, per ADR-0010's workload standard); safe to run\n";
	echo "  repeatedly and concurrently with ordinary stock bookings.\n\n";
	echo "  --product-id=N  Limit the run to one product's stock rows (N attached with '=',\n";
	echo "                  not a separate argument). Omit to sweep every product that\n";
	echo "                  currently has anything eligible.\n";
	echo "  --quiet         Only print errors.\n";
	echo "  --help, -h      Show this message and exit.\n\n";
	echo "  Any other argument - a bare --product-id, --product-id given as two words\n";
	echo "  (--product-id 12), --product-id repeated, or anything unrecognised - is\n";
	echo "  refused before anything else runs.\n";
	exit(0);
}

// Every other argument is walked strictly: only --product-id=<positive int> and --quiet are
// recognised, and anything else - a bare --product-id (whether alone, or immediately
// followed by its intended value as a SEPARATE argument, "--product-id 12": the space
// rather than "=" means this loop never sees the two as one option and its value - the "12"
// that follows is itself then rejected in its own right, as an unrecognised positional, one
// iteration later), a malformed --product-id=value, a repeated --product-id=, or any unknown
// flag or bare positional - is refused with an error naming it, before any database
// connection is opened (CodeRabbit review comment 4121713761: "--product-id 12", with a
// space, previously matched nothing at all, silently leaving $productId null and sweeping
// every product instead of the one requested). A repeated --product-id= is deliberately
// treated the same as any other malformed input rather than "last one wins" or "first one
// wins": silently picking either would hide a caller's own scripting mistake (a duplicated
// flag from a badly constructed argument list) behind whichever value happened to win, on a
// command that mutates data.
$quiet = false;
$productId = null;
$sawProductId = false;

foreach ($arguments as $argument)
{
	if ($argument === '--quiet')
	{
		$quiet = true;

		continue;
	}

	if (str_starts_with($argument, '--product-id='))
	{
		if ($sawProductId)
		{
			fwrite(STDERR, 'Invalid arguments: --product-id was given more than once' . PHP_EOL);
			exit(1);
		}
		$sawProductId = true;

		$rawProductId = substr($argument, strlen('--product-id='));

		// (int) casting silently turned every malformed value into 0 - "--product-id=abc"
		// and a bare "--product-id=" both targeted a product 0 that cannot exist, so the run
		// reported "No eligible stock rows to merge." and exited 0 as if it had succeeded,
		// and "--product-id=12x" silently compacted product 12 instead of being rejected
		// (CodeRabbit review comment 4121171258).
		$productId = filter_var($rawProductId, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
		if ($productId === false)
		{
			fwrite(STDERR, 'Invalid --product-id value: "' . $rawProductId . '" (must be a positive integer)' . PHP_EOL);
			exit(1);
		}

		continue;
	}

	fwrite(STDERR, 'Unrecognised argument: "' . $argument . '" (use --product-id=N, with = rather than a space; run --help for usage)' . PHP_EOL);
	exit(1);
}

if (!defined('VICTUAL_DATAPATH'))
{
	define('VICTUAL_DATAPATH', getenv('VICTUAL_DATAPATH') ?: __DIR__ . '/../data');
}

require_once __DIR__ . '/../packages/autoload.php';

// Same shape as bin/victual-migrate and bin/victual-publish-state: config.php is optional so
// that a checkout with only environment variables set still works.
if (file_exists(VICTUAL_DATAPATH . '/config.php'))
{
	require_once VICTUAL_DATAPATH . '/config.php';
}

require_once __DIR__ . '/../config-dist.php';

// stock_splits and the label eligibility check it now carries (ADR-0033 decision 3) resolve
// through the ordinary LessQL connection, not through a request - no user context is read or
// written by this command, but VICTUAL_USER_ID is defined for the same reason
// bin/victual-publish-state defines it: some engines resolve user settings through views this
// command's dependencies can touch.
if (!defined('VICTUAL_USER_ID'))
{
	define('VICTUAL_USER_ID', 1);
}

try
{
	(new Victual\Helpers\ConfigurationValidator())->validateConfig();
}
catch (\Victual\Helpers\EInvalidConfig $ex)
{
	fwrite(STDERR, 'Invalid setting in config.php: ' . $ex->getMessage() . PHP_EOL);
	exit(1);
}

DatabaseService::GetInstance()->SetCurrentUserId(VICTUAL_USER_ID);

try
{
	$db = DatabaseService::GetInstance()->GetDbConnectionRaw();

	if ($productId !== null)
	{
		$candidateStatement = $db->prepare('SELECT COUNT(*) FROM stock_splits WHERE product_id = ?');
		$candidateStatement->execute([$productId]);
		$candidateGroups = (int)$candidateStatement->fetchColumn();
		$candidateProducts = $candidateGroups > 0 ? 1 : 0;
	}
	else
	{
		$candidateGroups = (int)$db->query('SELECT COUNT(*) FROM stock_splits')->fetchColumn();
		$candidateProducts = (int)$db->query('SELECT COUNT(DISTINCT product_id) FROM stock_splits')->fetchColumn();
	}

	if (!$quiet)
	{
		echo $candidateGroups === 0
			? 'No eligible stock rows to merge.' . PHP_EOL
			: 'Found ' . $candidateGroups . ' eligible group(s) across ' . $candidateProducts . ' product(s); merging...' . PHP_EOL;
	}

	StockService::GetInstance()->CompactStockEntries($productId);

	if (!$quiet)
	{
		echo $candidateGroups === 0 ? 'Nothing to do.' . PHP_EOL : 'Compaction complete.' . PHP_EOL;
	}
}
catch (\Throwable $ex)
{
	fwrite(STDERR, 'Stock compaction failed: ' . $ex->getMessage() . PHP_EOL);
	exit(1);
}

exit(0);
