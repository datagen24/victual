# Every variable deploy/keycloak/realm.json reads. Copy, fill in every CHANGE-ME, and pass the result
# to the reconciler's environment; the reconciler refuses a CHANGE-ME or an unset variable.
# *_SECRET values are secrets: in the chart they come from Kubernetes Secrets, never from a values
# file or this file. The chart wiring is a follow-up (plan 43, "Chart integration").

# Where the reconciler reaches Keycloak, and Keycloak's public base URL (the issuer's prefix).
KEYCLOAK_URL=CHANGE-ME
# The reconciler's own admin credential: either a client in the master realm ...
KEYCLOAK_ADMIN_CLIENT_ID=CHANGE-ME
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE-ME
# ... or the bootstrap admin (leave KEYCLOAK_ADMIN_CLIENT_ID unset to use these).
# KEYCLOAK_ADMIN_USERNAME=CHANGE-ME
# KEYCLOAK_ADMIN_PASSWORD=CHANGE-ME

# Victual's browser-login client (ADR-0058 decision 2).
VICTUAL_REDIRECT_URI=CHANGE-ME
VICTUAL_POST_LOGOUT_REDIRECT_URI=CHANGE-ME
VICTUAL_CLIENT_SECRET=CHANGE-ME

# Canonical resource URIs: /api's audience and the MCP sidecar's (ADR-0055 decision 3).
VICTUAL_API_AUDIENCE=CHANGE-ME
VICTUAL_MCP_AUDIENCE=CHANGE-ME

# Service-account client authentication (ADR-0057 question 6): the namespace Victual's workloads
# run in, and the cluster's service-account issuer.
VICTUAL_NAMESPACE=CHANGE-ME
KUBERNETES_SA_ISSUER=CHANGE-ME

# The SCIM sender's client secret, shared with the upstream's provisioning service (ADR-0058 decision 5).
SCIM_CLIENT_SECRET=CHANGE-ME

# Entra ID (template only, untested: ADR-0058 prerequisites 2 to 4). Leave ENTRA_TENANT_ID unset to
# leave the provider out; the reconciler then deletes one it created earlier.
# ENTRA_TENANT_ID=CHANGE-ME
# ENTRA_CLIENT_ID=CHANGE-ME
# ENTRA_CLIENT_SECRET=CHANGE-ME
