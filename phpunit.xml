<?xml version="1.0" encoding="UTF-8"?>
<!--
	Tier 1 (ADR-0025): PHPUnit against a real PostgreSQL. Each testsuite is one of the
	bespoke phases .devtools/pgsql/run-tests.sh migrates a phase at a time - the
	testsuite name matches the run-tests.sh target exactly, per decision 3, so
	running phpunit with "testsuite=rbac" is what the rbac phase now runs.

	The connection is never configured here: each test class gets its own schema and
	injects DatabaseService's singleton by reflection (see
	Victual\Tests\Support\PgsqlSchemaTestCase), reading PGHOST/PGPORT/PGUSER/PGPASSWORD,
	PHPUNIT_DB_NAME and VICTUAL_DATAPATH from the environment run-tests.sh already sets up
	for every other phase.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="packages/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	colors="true"
	failOnWarning="true"
	failOnDeprecation="false"
	beStrictAboutOutputDuringTests="false">
	<testsuites>
		<testsuite name="rbac">
			<file>tests/Pgsql/RbacTest.php</file>
			<file>tests/Pgsql/RecipeCopyPermissionTest.php</file>
		</testsuite>
		<testsuite name="contract">
			<file>tests/Pgsql/ContractTest.php</file>
		</testsuite>
		<testsuite name="credentialsplit">
			<file>tests/Pgsql/CredentialSplitTest.php</file>
			<file>tests/Pgsql/MigrationRunnerAtomicityTest.php</file>
		</testsuite>
		<testsuite name="shopliststores">
			<file>tests/Pgsql/ShoppingListStoresTest.php</file>
			<file>tests/Pgsql/ShoppingListScopeTest.php</file>
		</testsuite>
		<testsuite name="mealplan">
			<file>tests/Pgsql/MealPlanRedactionTest.php</file>
		</testsuite>
		<testsuite name="rootentry">
			<file>tests/Pgsql/RootEntryTest.php</file>
		</testsuite>
		<testsuite name="mcpauth">
			<file>tests/Pgsql/McpAuthTest.php</file>
		</testsuite>
		<testsuite name="bootstrapadmin">
			<file>tests/Pgsql/BootstrapAdminTest.php</file>
			<file>tests/Pgsql/PasswordRotationTest.php</file>
		</testsuite>
		<testsuite name="uploadclamp">
			<file>tests/Pgsql/FileSizeLimitTest.php</file>
		</testsuite>
		<testsuite name="labeltracking">
			<file>tests/Pgsql/LabelWriteTrackingTest.php</file>
		</testsuite>
		<testsuite name="serverversion">
			<file>tests/Pgsql/ServerVersionTest.php</file>
		</testsuite>
		<testsuite name="wirecontract">
			<file>tests/Pgsql/WireContractTest.php</file>
			<file>tests/Pgsql/StockEntryEditContractTest.php</file>
		</testsuite>
		<testsuite name="stockpages">
			<file>tests/Pgsql/StockPagesTest.php</file>
			<file>tests/Pgsql/StockEntryFormPriceTest.php</file>
		</testsuite>
		<testsuite name="householdpages">
			<file>tests/Pgsql/HouseholdPagesTest.php</file>
		</testsuite>
		<testsuite name="labelapi">
			<file>tests/Pgsql/LabelApiTest.php</file>
			<file>tests/Pgsql/LabelResolveSchemaTest.php</file>
		</testsuite>
		<testsuite name="labelservices">
			<file>tests/Pgsql/LabelServicesTest.php</file>
		</testsuite>
		<testsuite name="authstack">
			<file>tests/Pgsql/AuthStackTest.php</file>
		</testsuite>
		<testsuite name="helperunits">
			<file>tests/Pgsql/HelperUnitsTest.php</file>
		</testsuite>
		<testsuite name="barcodelookup">
			<file>tests/Pgsql/BarcodeLookupTest.php</file>
			<file>tests/Pgsql/OutboundHostPolicyTest.php</file>
			<file>tests/Pgsql/GtinTest.php</file>
		</testsuite>
		<testsuite name="storagefiles">
			<file>tests/Pgsql/StorageFilesTest.php</file>
		</testsuite>
		<testsuite name="stockcoverage">
			<file>tests/Pgsql/StockCoverageTest.php</file>
