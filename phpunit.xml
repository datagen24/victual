		</testsuite>
		<testsuite name="demodata">
			<file>tests/Pgsql/DemoDataTest.php</file>
		</testsuite>
		<testsuite name="dialectpolicy">
			<file>tests/Pgsql/DialectPolicyTest.php</file>
			<file>tests/Pgsql/SchemaIsolationFirstTest.php</file>
			<file>tests/Pgsql/SchemaIsolationSecondTest.php</file>
		</testsuite>
		<testsuite name="httpboot">
